<!--
  A interface do Проводник: WPF + HandyControls + CommunityToolkit.Mvvm, no padrão do Windfinder e da Связь
  (vertical slice em Features/, Shell/ e Shared/, DI montada na mão no App).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RollForward>Major</RollForward>
    <AssemblyName>Provodnik</AssemblyName>
    <RootNamespace>Provodnik.Wpf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\provodnik.ico</ApplicationIcon>
    <!--  Main próprio (Program.cs): o Velopack roda antes do WPF  -->
    <StartupObject>Provodnik.Wpf.Program</StartupObject>
  </PropertyGroup>

  <!--
    Publicação pra morar na pasta do GAMMA: um exe só, com o .NET dentro (quem joga não precisa instalar nada).
    O tools\build_tool.py (opções exe e gamma) chama com -p:Distribuir=true. O pacote do Velopack não usa isto.
  -->
  <PropertyGroup Condition="'$(Distribuir)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="HandyControls" Version="3.6.0" />
    <PackageReference Include="HandyControl.Lang.pt-BR" Version="3.5.1" />
    <!--  Ícones: Phosphor Icons (todos os ícones do app saem daqui)  -->
    <PackageReference Include="MahApps.Metro.IconPacks.PhosphorIcons" Version="6.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!--  O navegador que passa pelo Cloudflare do ModDB (Features/Install/ModDbBrowser.cs)  -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!--  Atualização do próprio Проводник pelo GitHub Releases (Features/AppUpdate)  -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\provodnik.ico" />
    <Resource Include="Assets\provodnik.png" />
  </ItemGroup>

  <!--  As novidades vão dentro do exe  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\CHANGELOG.md" LogicalName="Provodnik.CHANGELOG.md" />
    <!--  A lista de mods de verdade pra simulação (a opção demo): os nomes reais, sem baixar nada  -->
    <EmbeddedResource Include="..\..\tests\Provodnik.Tests\Data\mods.txt" LogicalName="Provodnik.demo-mods.txt" />
  </ItemGroup>

  <!--
    Mesmo guarda do Windfinder: XAML que cai fora do Page não vira BAML e só quebra ao abrir a tela.
    Isto vira erro de build dizendo qual arquivo ficou de fora.
  -->
  <Target Name="ConferirXamlNoPage" BeforeTargets="MarkupCompilePass1">
    <ItemGroup>
      <XamlNoDisco Include="Features\**\*.xaml;Shell\**\*.xaml;Shared\**\*.xaml" />
      <XamlForaDoPage Include="@(XamlNoDisco)" Exclude="@(Page)" />
    </ItemGroup>
    <Error Condition="'@(XamlForaDoPage)' != ''" Text="XAML fora do Page (não vira BAML e o app quebra ao abrir a tela): @(XamlForaDoPage). Apague do csproj o &lt;Page Remove&gt;/&lt;None Include&gt; desse arquivo." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Provodnik.Core\Provodnik.Core.csproj" />
    <ProjectReference Include="..\Provodnik.Features\Provodnik.Features.csproj" />
    <ProjectReference Include="..\Provodnik.Infrastructure\Provodnik.Infrastructure.csproj" />
  </ItemGroup>

  <!--  Os textos em português, inglês e russo (Provodnik.Core.Text.L lê os que terminam em .pt/.en/.ru.json)  -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

</Project>
