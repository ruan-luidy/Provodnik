<hc:Window
  x:Class="Provodnik.Wpf.Shell.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="clr-namespace:Provodnik.Wpf.Shared.Services"
  xmlns:shell="clr-namespace:Provodnik.Wpf.Shell"
  Title="{Binding Title}"
  Width="1180"
  Height="760"
  MinWidth="900"
  MinHeight="560"
  d:DataContext="{d:DesignInstance Type=shell:MainViewModel}"
  hc:Dialog.Token="{x:Static services:DialogService.Token}"
  BorderBrush="{DynamicResource BorderBrush}"
  NonClientAreaBackground="Transparent"
  Icon="/Provodnik;component/Assets/provodnik.ico"
  ShowTitle="True"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">

  <!--  A barra de tarefas mostra o andamento da instalação, mesmo com a janela minimizada  -->
  <hc:Window.TaskbarItemInfo>
    <TaskbarItemInfo ProgressState="{Binding Install.IsRunning, Converter={StaticResource TaskbarState}}" ProgressValue="{Binding Install.Overall}" />
  </hc:Window.TaskbarItemInfo>

  <!--
    Barra de título: o nome do app é o Title do próprio hc:Window; à direita, enquanto instala, a pílula com o
    andamento, que leva pra tela de instalação. Sem fundo: o resto da barra continua arrastando a janela.
  -->
  <hc:Window.NonClientAreaContent>
    <Grid>
      <!--  Etiqueta SIMULAÇÃO na simulação (opção demo): nada ali baixa nem mexe no GAMMA de verdade  -->
      <Border
        Margin="6,0,0,0"
        Padding="6,1"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Background="{DynamicResource PrimaryBrush}"
        CornerRadius="{StaticResource Radius.Sm}"
        ToolTip="Simulação: GAMMA de mentira em %TEMP%\provodnik-demo, ferramentas falsas, tempo acelerado"
        Visibility="{Binding IsDemo, Converter={StaticResource Boolean2VisibilityConverter}}">
        <TextBlock
          FontSize="{StaticResource FontSize.XS}"
          FontWeight="Bold"
          Foreground="White"
          Text="SIMULAÇÃO" />
      </Border>
      <!--  Etiqueta ADMIN encostada no nome do app, só quando elevado  -->
      <Border
        Margin="6,0,0,0"
        Padding="6,1"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Background="{DynamicResource WarningBrush}"
        CornerRadius="{StaticResource Radius.Sm}"
        ToolTip="Rodando como administrador. O MO2 e o jogo abrem sem administrador mesmo assim."
        Visibility="{Binding IsElevated, Converter={StaticResource Boolean2VisibilityConverter}}">
        <TextBlock
          FontSize="{StaticResource FontSize.XS}"
          FontWeight="Bold"
          Foreground="Black"
          Text="ADMIN" />
      </Border>
      <!--
        A instalação rodando, no molde do botão de usuário do Windfinder: sem fundo (só no hover), o carregando, o
        andamento em número e uma barra fina. Clica e vai pra tela de instalação.
      -->
      <Button
        Height="26"
        Margin="0,0,10,0"
        Padding="10,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Background="Transparent"
        BorderThickness="0"
        Command="{Binding GoInstallCommand}"
        Cursor="Hand"
        ToolTip="Ver a instalação"
        Visibility="{Binding Install.IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Box"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource Radius.Md}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
          <hc:CircleProgressBar
            Width="12"
            Height="12"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            Style="{StaticResource BusyCircle}" />
          <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize.Sm}">
            <Run Foreground="{DynamicResource SecondaryTextBrush}" Text="Instalando" /><Run Text=" " /><Run
              FontFamily="{StaticResource FontFamily.Numbers}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource PrimaryTextBrush}"
              Text="{Binding Install.Done, Mode=OneWay}" /><Run
              FontFamily="{StaticResource FontFamily.Numbers}"
              Foreground="{DynamicResource SecondaryTextBrush}"
              Text="{Binding Install.Total, Mode=OneWay, StringFormat=' / {0}'}" />
          </TextBlock>
          <ProgressBar
            Width="64"
            Height="4"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Maximum="1"
            Value="{Binding Install.Overall, Mode=OneWay}" />
        </StackPanel>
      </Button>
    </Grid>
  </hc:Window.NonClientAreaContent>

  <Grid>
    <Grid.ColumnDefinitions>
      <!--  O painel: 200 aberto, 52 recolhido (só os ícones)  -->
      <ColumnDefinition>
        <ColumnDefinition.Style>
          <Style TargetType="ColumnDefinition">
            <Setter Property="Width" Value="200" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding PaneCompact}" Value="True">
                <Setter Property="Width" Value="52" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ColumnDefinition.Style>
      </ColumnDefinition>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!--  ===== Painel lateral: as telas em cima, Configurações no rodapé =====  -->
    <!--  Sem fundo próprio: o Mica (ou o RegionBrush da janela, sem ele) aparece direto no painel  -->
    <Border
      Background="Transparent"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="0,0,1,0">
      <DockPanel Margin="8,8">
        <Border
          Margin="0,6,0,0"
          Padding="0,6,0,0"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,1,0,0"
          DockPanel.Dock="Bottom">
          <Button
            Command="{Binding OpenSettingsCommand}"
            Content="Configurações"
            Style="{StaticResource SideNavButton}"
            Tag="{icons:Phosphor GearSixBold}" />
        </Border>

        <StackPanel DockPanel.Dock="Top">
          <Button
            Margin="0,0,0,4"
            hc:IconElement.Geometry="{icons:Phosphor ListBold}"
            Command="{Binding TogglePaneCommand}"
            Style="{StaticResource PaneToggle}"
            ToolTip="Recolher ou abrir o painel" />
          <RadioButton
            Content="Início"
            GroupName="Nav"
            IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter={x:Static services:Tab.Home}}"
            Style="{StaticResource SideNavItem}"
            Tag="{icons:Phosphor HouseBold}" />
          <RadioButton
            controls:NavBadge.Count="{Binding Install.Failures.Count}"
            controls:NavBadge.IsAlert="True"
            Content="Instalar"
            GroupName="Nav"
            IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter={x:Static services:Tab.Install}}"
            Style="{StaticResource SideNavItem}"
            Tag="{icons:Phosphor DownloadSimpleBold}" />
          <RadioButton
            Content="Mods"
            GroupName="Nav"
            IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter={x:Static services:Tab.Mods}}"
            Style="{StaticResource SideNavItem}"
            Tag="{icons:Phosphor PackageBold}" />
          <RadioButton
            Content="Registro"
            GroupName="Nav"
            IsChecked="{Binding Tab, Converter={StaticResource Is}, ConverterParameter={x:Static services:Tab.Logs}}"
            Style="{StaticResource SideNavItem}"
            Tag="{icons:Phosphor ScrollBold}" />
        </StackPanel>

        <Grid />
      </DockPanel>
    </Border>

    <!--  Linha entre a barra de título e a área da janela  -->
    <Border
      Grid.ColumnSpan="2"
      Height="1"
      VerticalAlignment="Top"
      Panel.ZIndex="1"
      Background="{DynamicResource BorderBrush}"
      IsHitTestVisible="False" />

    <!--  A tela aberta; por cima, o erro e o carregando  -->
    <!--  A tela uma camada acima do painel: branco translúcido por cima do Mica  -->
    <Grid Grid.Column="1" Background="{DynamicResource Pane.BackgroundBrush}">
      <ContentControl x:Name="Page" Content="{Binding Current}" />

      <controls:ErrorState RetryCommand="{Binding Current.ReloadCommand}" Text="{Binding Current.Error}" />

      <controls:LoadingOverlay Visibility="{Binding Current.IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" />
    </Grid>
  </Grid>
</hc:Window>
