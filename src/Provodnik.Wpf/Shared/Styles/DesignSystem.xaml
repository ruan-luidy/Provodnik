<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:Provodnik.Wpf.Shared.Behaviors"
  xmlns:converters="clr-namespace:Provodnik.Wpf.Shared.Converters"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:system="clr-namespace:System;assembly=mscorlib">

  <!--  Os tokens (espaçamento, raio, fonte, cores base) moram no Tokens.xaml, carregado antes de tudo  -->

  <!--
    ========================================
    SURFACE CARD - Container padrão de painel
    ========================================
    Cada painel é um cartão: as cores do Negativo - a página é o RegionBrush (o fundo padrão da janela do
    HandyControl) e o cartão é o SecondaryRegionBrush em cima dela, como a grade e as faixas. Sem contorno. Raio Lg.
  -->
  <Style x:Key="SurfaceCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
  </Style>

  <!--
    ========================================
    TEXTOS
    ========================================
  -->
  <Style x:Key="SectionHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!--  Cabeçalho de painel estilo terminal: caixa alta, pequeno, com espaçamento de letra  -->
  <Style x:Key="PanelHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  Caption / hint text padrão  -->
  <!--  Legenda: SecondaryText (o Thirdly sumia no fundo escuro, e a legenda carrega informação)  -->
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--  Número de mercado: fonte tabular, alinhado à direita  -->
  <Style x:Key="NumberText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!--
    ========================================
    STAT - rótulo pequeno + valor (Bid, Ask, Abertura...)
    ========================================
    Usado pelo controle StatBlock (Controls/StatBlock.xaml). Mesmo molde do KpiLabel/KpiValue do Observer,
    em escala menor: o quote panel mostra sete deles lado a lado.
  -->
  <Style x:Key="StatLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style
    x:Key="StatValue"
    BasedOn="{StaticResource NumberText}"
    TargetType="TextBlock">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Md}" />
    <Setter Property="TextAlignment" Value="Left" />
  </Style>

  <!--
    ========================================
    CHIP - ToggleButton em pílula com bolinha de cor
    ========================================
    Os botões de indicador do gráfico (SMA20, RSI...). A cor da bolinha e da borda quando ligado vem do Tag
    (string "#ffd966" ou Brush), então cada chip tem a cor da linha que ele desenha.
    O HandyControl não tem esse formato; é um dos componentes inventados do projeto.

    <ToggleButton Content="SMA20" Tag="#ffd966" Style="{StaticResource ChipToggleButton}" />
  -->
  <Style x:Key="ChipToggleButton" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Chip"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Sm}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <Ellipse
                x:Name="Dot"
                Width="7"
                Height="7"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                Opacity="0.45" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
              <Setter TargetName="Chip" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Dot" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ========================================
    SEGMENTADO COMPACTO - grupo de RadioButton na altura de toolbar
    ========================================
    O ButtonGroup do HandyControl tem 30 px de altura: numa barra de gráfico com três grupos (janela, estilo,
    ferramentas) isso come a área do gráfico. Este é o mesmo conceito, na densidade de terminal: uma caixa com
    borda e os itens dentro, o marcado pintado com o accent. A altura é fixa no Toolbar.ControlHeight - antes
    ela vinha da fonte e o grupo ficava 1-2 px fora dos campos do lado.

    <Border Style="{StaticResource SegmentedGroup}">
      <StackPanel Orientation="Horizontal">
        <RadioButton Content="1D" Style="{StaticResource SegmentedRadio}" IsChecked="..." />
      </StackPanel>
    </Border>
  -->
  <Style x:Key="SegmentedGroup" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="0,0,6,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SegmentedRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border
            x:Name="Segment"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Mesmo visual do segmentado, mas pra ligar/desligar (VOL, LOG, o menu de indicadores)  -->
  <Style x:Key="SegmentedToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Segment"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Ferramenta com ícone (desenho do gráfico): o ícone vai no Tag como Geometry  -->
  <Style
    x:Key="SegmentedIconRadio"
    BasedOn="{StaticResource SegmentedRadio}"
    TargetType="RadioButton">
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Path
            Width="13"
            Height="13"
            Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}"
            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
            Stretch="Uniform" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Botão de ícone no mesmo tamanho do segmentado (desfazer, apagar, copiar...)  -->
  <Style x:Key="SegmentedIconButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Segment"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="3">
            <Path
              Width="13"
              Height="13"
              Data="{TemplateBinding Tag}"
              Fill="{TemplateBinding Foreground}"
              Stretch="Uniform" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Chip de ativo comparado: bolinha da cor, ticker, variação e ×  -->
  <Style x:Key="CompareChip" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="Padding" Value="8,0,2,0" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    ========================================
    CHIP DE ENTRADA - caixa de texto com cara de chip
    ========================================
    Pra barra do gráfico: o campo "comparar" fica do mesmo tamanho e formato dos chips de indicador ao lado, em vez
    de um TextBox retangular no meio deles. O host é a pílula; dentro vão o TextBox sem borda e o botão do ícone.
  -->
  <Style x:Key="ChipInputHost" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="Padding" Value="7,0,2,0" />
    <Setter Property="Margin" Value="4,0,4,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ChipTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CharacterCasing" Value="Upper" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer
            x:Name="PART_ContentHost"
            Padding="{TemplateBinding Padding}"
            VerticalAlignment="Center"
            Focusable="False"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Botão de ícone do tamanho de um chip (o "+" do campo de comparar)  -->
  <Style x:Key="ChipIconButton" TargetType="Button">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Chip"
            Background="Transparent"
            CornerRadius="3">
            <Path
              Width="10"
              Height="10"
              Data="{TemplateBinding Tag}"
              Fill="{TemplateBinding Foreground}"
              Stretch="Uniform" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ========================================
    CAMPOS DE BARRA DE FERRAMENTAS
    ========================================
    Todo campo que fica numa barra de widget (ticker, filtro, seletor de vencimento, fuso, canal) usa a mesma
    altura do Toolbar.ControlHeight (definido lá em cima) e o mesmo corpo de texto. Sem isso cada painel puxava
    a altura padrão do HandyControl (30 px) e a barra ficava de tamanho diferente em cada widget.
  -->

  <!--
    BasedOn no estilo implícito do HandyControl é obrigatório: sem ele, dar um Style explícito ao hc:TextBox
    joga fora o template do tema e o WPF cai no TextBox cru - fundo branco e sem placeholder no meio do terminal
    escuro. Vale pro mesmo caso em qualquer controle do HandyControl.
  -->
  <!--
    Base "Small" do HandyControl com o miolo na altura da caixa: com a base normal o miolo tinha no mínimo 28 px
    numa caixa de 24, e a borda de baixo e o texto saíam cortados, com o placeholder caído pra baixo.
  -->
  <Style
    x:Key="ToolbarTextBox"
    BasedOn="{StaticResource TextBoxExtend.Small}"
    TargetType="{x:Type hc:TextBox}">
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="hc:InfoElement.MinContentHeight" Value="0" />
    <Setter Property="hc:InfoElement.ContentHeight" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!--
    Sem estilo implícito de hc:TextBox nem de hc:ComboBox (o Терминал encolhia todo campo pra 24 px): os campos
    ficam na altura padrão do HandyControl, a mesma do Negativo. O ToolbarTextBox continua pra quem pedir pela chave.
  -->

  <!--
    O LoadingCircle do HandyControl nasce girando e só para quando alguém muda o IsRunning: escondido (Collapsed,
    ou numa aba que não está aberta) ele continuava animando pra sempre, e o relógio de animação do WPF redesenhava
    a janela a cada quadro com o terminal parado. Amarrado ao IsVisible, ele só gira quando dá pra ver.
  -->
  <Style BasedOn="{StaticResource {x:Type hc:LoadingCircle}}" TargetType="{x:Type hc:LoadingCircle}">
    <Setter Property="IsRunning" Value="{Binding IsVisible, RelativeSource={RelativeSource Self}}" />
  </Style>

  <!--
    O carregando pequeno das faixas de status (o do Exportar, o do Negativo): o CircleProgressBar do HandyControl em
    16 px, no lugar das bolinhas do LoadingCircle em todas as telas. Gira só visível, pelo mesmo motivo de cima.
  -->
  <Style
    x:Key="BusyCircle"
    BasedOn="{StaticResource {x:Type hc:CircleProgressBar}}"
    TargetType="{x:Type hc:CircleProgressBar}">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="ArcThickness" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsIndeterminate" Value="{Binding IsVisible, RelativeSource={RelativeSource Self}}" />
  </Style>

  <!--  Campo de ticker/preço: números na fonte tabular e em caixa alta  -->
  <Style
    x:Key="ToolbarTickerBox"
    BasedOn="{StaticResource ToolbarTextBox}"
    TargetType="{x:Type hc:TextBox}">
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
    <Setter Property="CharacterCasing" Value="Upper" />
  </Style>

  <Style
    x:Key="ToolbarComboBox"
    BasedOn="{StaticResource {x:Type hc:ComboBox}}"
    TargetType="{x:Type hc:ComboBox}">
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>


  <Style
    x:Key="ToolbarButton"
    BasedOn="{StaticResource ButtonDefault.Small}"
    TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style
    x:Key="ToolbarButtonPrimary"
    BasedOn="{StaticResource ButtonPrimary.Small}"
    TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Toolbar.ControlHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!--
    Caixa de filtro da tabela: a mesma em todo painel, ligada no behaviors:QuickFilter da tabela. Uma caixa só
    que compara com todo texto da linha - é o "quick filter" do AG Grid, e evita inventar um filtro por coluna.
  -->
  <Style
    x:Key="FilterBox"
    BasedOn="{StaticResource ToolbarTextBox}"
    TargetType="{x:Type hc:TextBox}">
    <Setter Property="Width" Value="150" />
    <Setter Property="hc:IconElement.Geometry" Value="{icons:Phosphor MagnifyingGlassBold}" />
    <Setter Property="hc:InfoElement.Placeholder" Value="Filtrar" />
    <Setter Property="ToolTip" Value="Filtra a tabela por qualquer coluna, sem acento e sem ligar pra maiúscula" />
  </Style>

  <!--  Rótulo curto na frente de um campo ("Vencimento", "Fuso", "Canal")  -->
  <Style
    x:Key="ToolbarLabel"
    BasedOn="{StaticResource CaptionText}"
    TargetType="TextBlock">
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <!--
    ========================================
    ESTADO VAZIO
    ========================================
    Painel sem dado (ativo que não existe, cadeia de opções vazia, carteira sem operação) mostra uma mensagem
    centralizada em vez de uma tabela só com cabeçalho ou de um gráfico com eixo de -10 a 10.
  -->
  <Style x:Key="EmptyStateText" TargetType="TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="24,12" />
    <Setter Property="MaxWidth" Value="380" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <!--
    Mesma mensagem, mas quando o motivo é erro: âmbar, porque o dado pode voltar sozinho no próximo refresh.
    O âmbar é DynamicResource e não StaticResource: ele mora no MarketColors.xaml, que é mesclado DEPOIS deste
    dicionário (o MarketColors usa a fonte e o raio daqui, então a ordem não pode inverter). Com StaticResource a
    cor saía como UnsetValue e o Foreground estourava na primeira medição da tela.
  -->
  <Style
    x:Key="EmptyStateErrorText"
    BasedOn="{StaticResource EmptyStateText}"
    TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Market.StaleBrush}" />
  </Style>

  <!--
    ========================================
    TABELA DE TERMINAL - DataGrid denso
    ========================================
    Linha de 22 px e cabeçalho pequeno: a tabela densa de terminal. Toda tabela de widget usa. A grade é
    desenhada pelos estilos de linha, célula e cabeçalho abaixo (separador entre linhas e entre colunas).
  -->
  <!--  Fundo escurecido por cima do que está carregando (o LoadingOverlay gira o círculo em cima)  -->
  <SolidColorBrush
    x:Key="Overlay.DimBrush"
    Opacity="0.55"
    Color="#000000" />

  <!--  "É a última coluna visível?" (célula e cabeçalho dela saem sem o separador da direita)  -->
  <converters:LastColumnConverter x:Key="IsLastColumn" />

  <!--
    Cabeçalho: separador de coluna na direita (mesma cor e mesmo x do das células) e a linha de baixo. A última
    coluna e o pedaço que sobra depois dela ficam sem o da direita: colado na borda do painel a linha saía dupla.
    O Column do cabeçalho não avisa quando muda; o DisplayIndex dele avisa e refaz a conta.
  -->
  <Style
    x:Key="TerminalColumnHeader"
    BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}"
    TargetType="DataGridColumnHeader">
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryRegionBrush}" />
    <Style.Triggers>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <MultiBinding Converter="{StaticResource IsLastColumn}">
            <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
            <Binding Path="DisplayIndex" RelativeSource="{RelativeSource Self}" />
            <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" />
          </MultiBinding>
        </DataTrigger.Binding>
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--
    Linha: o separador (1 px) é desenhado aqui, embaixo e FORA do destaque, e o destaque (hover/seleção) tem o
    mesmo respiro em cima e embaixo. Com a grade do DataGrid o separador ficava dentro da linha e o destaque
    encostava nele. Os detalhes da linha (RowDetails, a agenda usa) ficam embaixo das células.
  -->
  <Style
    x:Key="TerminalDataGridRow"
    BasedOn="{StaticResource DataGridRowStyle.Small}"
    TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
              Margin="0,1,0,2"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource Radius.Sm}" />
            <DataGridCellsPresenter
              Margin="0,0,0,1"
              ItemsPanel="{TemplateBinding ItemsPanel}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <DataGridDetailsPresenter
              Grid.Row="1"
              Margin="0,0,0,1"
              Visibility="{TemplateBinding DetailsVisibility}" />
            <Border
              Grid.RowSpan="2"
              Height="1"
              VerticalAlignment="Bottom"
              Background="{DynamicResource SecondaryRegionBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Hover.RowBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Selection.RowBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Célula sem fundo próprio (quem pinta seleção e hover é a linha), com o separador de coluna na borda direita.
    A grade do DataGrid não deixa tirar a linha de uma coluna só, por isso ela fica desligada e a borda é daqui; a
    última coluna sai sem. Template próprio porque o do HandyControl recua a borda 4 px e o risco não bateria com
    o do cabeçalho (os 4 px viram 3 de margem + 1 do risco).
  -->
  <Style
    x:Key="TerminalDataGridCell"
    BasedOn="{StaticResource DataGridCellStyle.Small}"
    TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <ContentPresenter
              Margin="0,0,3,0"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      </Trigger>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <MultiBinding Converter="{StaticResource IsLastColumn}">
            <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
            <Binding Path="Column.DisplayIndex" RelativeSource="{RelativeSource Self}" />
            <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" />
            <Binding Path="Column.Visibility" RelativeSource="{RelativeSource Self}" />
          </MultiBinding>
        </DataTrigger.Binding>
        <Setter Property="BorderThickness" Value="0" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style
    x:Key="TerminalDataGrid"
    BasedOn="{StaticResource DataGrid.Small}"
    TargetType="DataGrid">
    <Setter Property="RowStyle" Value="{StaticResource TerminalDataGridRow}" />
    <Setter Property="CellStyle" Value="{StaticResource TerminalDataGridCell}" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource TerminalColumnHeader}" />
    <!--  Botão direito: copiar a tabela / exportar CSV (Behaviors/DataGridExport.cs)  -->
    <Setter Property="behaviors:DataGridExport.IsEnabled" Value="True" />
    <!--  Mais linhas embaixo: as últimas somem num degradê, sem linha cortada ao meio (Behaviors/ScrollFade.cs)  -->
    <Setter Property="behaviors:ScrollFade.IsEnabled" Value="True" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <!--
      Sem isso o WPF casa a seleção com o "item atual" da coleção e marca a primeira linha sozinho ao carregar -
      e tabela que troca o ativo da tela ao selecionar (macro, watchlist, screener) roubava o ativo ao abrir.
    -->
    <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="22" />
    <Setter Property="ColumnHeaderHeight" Value="24" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
  </Style>

  <!--  Cabeçalho de coluna de número: alinhado à direita, junto com os valores  -->
  <Style
    x:Key="NumberColumnHeader"
    BasedOn="{StaticResource TerminalColumnHeader}"
    TargetType="DataGridColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>

  <!--  Célula de número: fonte tabular à direita  -->
  <Style x:Key="NumberCell" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style x:Key="TextCell" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--
    Botão que parece linha de lista (manchete, item do resumo): sem borda, realce no mouse. Conteúdo à esquerda.
  -->
  <Style x:Key="RowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <!--
      A linha fica em CIMA da linha, não embaixo: assim ela separa um item do outro e o último item não sobra com
      um risco solto encostando na borda do painel. O primeiro item da lista perde a linha pelo gatilho abaixo
      (PreviousData é nulo só nele), então a lista começa limpa embaixo do cabeçalho.
    -->
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Row"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
        <Setter Property="BorderThickness" Value="0" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--  Barra de ferramentas de widget (filtros, abas): faixa no topo do conteúdo  -->
  <Style x:Key="WidgetToolbar" TargetType="Panel">
    <Setter Property="Margin" Value="6,4,6,4" />
  </Style>

  <!--
    ========================================
    DIÁLOGO E TOAST (o sistema do rnzNegativeObserver)
    ========================================
    Cartão do diálogo entra crescendo de 95% e subindo 10 px em 250 ms; o toast desliza do topo. Os dois usam o
    cartão escuro com borda de 1 px e raio 12, igual no Negativo.
  -->
  <Style x:Key="DialogBorderAnimated" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <TransformGroup>
          <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
          <TranslateTransform Y="10" />
        </TransformGroup>
      </Setter.Value>
    </Setter>
    <Setter Property="Opacity" Value="0" />
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation
              Storyboard.TargetProperty="Opacity"
              From="0"
              To="1"
              Duration="0:0:0.2">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
              Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
              From="0.95"
              To="1"
              Duration="0:0:0.25">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
              Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
              From="0.95"
              To="1"
              Duration="0:0:0.25">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
              Storyboard.TargetProperty="(RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
              From="10"
              To="0"
              Duration="0:0:0.25">
              <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
              </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!--
    ========================================
    BOTÃO FLUTUANTE DO GRÁFICO
    ========================================
    Redondo, translúcido e sem borda por cima do gráfico (o "ir pro último candle"): some no fundo até o mouse
    chegar, aí acende no accent. Ícone vai no Tag (Geometry).
  -->
  <Style x:Key="ChartFloatingButton" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse
              x:Name="Disc"
              Fill="{DynamicResource SecondaryRegionBrush}"
              Opacity="0.92"
              Stroke="{DynamicResource BorderBrush}"
              StrokeThickness="1">
              <Ellipse.Effect>
                <DropShadowEffect
                  BlurRadius="10"
                  Opacity="0.45"
                  ShadowDepth="2"
                  Color="Black" />
              </Ellipse.Effect>
            </Ellipse>
            <Path
              Width="11"
              Height="11"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="{TemplateBinding Tag}"
              Fill="{TemplateBinding Foreground}"
              Stretch="Uniform" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
              <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
              <Setter TargetName="Disc" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Disc" Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
