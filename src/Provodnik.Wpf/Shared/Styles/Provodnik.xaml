<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:shared="clr-namespace:Provodnik.Wpf.Shared" xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls" xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons">

  <!--
    A REGRA DE BORDA (a do rnzNegativeObserver, levada até o fim): nada na tela tem contorno. Faixa (busca,
    cabeçalho, status) se separa pelo fundo cinza (SecondaryRegionBrush), cartão (SurfaceCard) pelo fundo
    RegionBrush em cima da página, e grade vai direto na tela. Só o que flutua (popup, diálogo) tem contorno.

    O BorderRegion do HandyControl é usado em muita tela: aqui ele ganha o raio do design system e perde a borda.
    {StaticResource BorderRegion} resolve pro do HC porque este ainda não foi registrado (o mesmo truque do Negativo).
  -->
  <Style
    x:Key="BorderRegion"
    BasedOn="{StaticResource BorderRegion}"
    TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    Sombra de popup (a do fpdf, Shared/Themes/Styles.xaml): Popup só desenha dentro dos próprios limites, então quem
    segura um cartão com sombra deixa uma margem pra ela (PopupShadowRoom) e desconta essa margem ao posicionar. A
    sombra vai numa borda separada ATRÁS do cartão: Effect no próprio cartão tiraria o ClearType do texto, e a sombra
    grande do Shadow.Card (blur 28) não cabia e saía cortada.

    <Grid Margin="{StaticResource PopupShadowRoom}">
      <Border Style="{StaticResource PopupShadow}" />
      <Border Style="{StaticResource PopupCard}">...</Border>
    </Grid>
  -->
  <Thickness x:Key="PopupShadowRoom">12,10,12,16</Thickness>

  <DropShadowEffect
    x:Key="Shadow.Popup"
    BlurRadius="12"
    Direction="270"
    Opacity="0.45"
    ShadowDepth="3"
    Color="Black" />

  <Style x:Key="PopupShadow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Effect" Value="{StaticResource Shadow.Popup}" />
  </Style>

  <Style x:Key="PopupCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
  </Style>

  <!--  Texto de estado colorido pelo Tone da linha (RowTone): verde ok, amarelo atenção, vermelho erro  -->
  <Style x:Key="ToneText" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Success}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Warning}">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Error}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--
    O mesmo dentro de célula de grade: na linha escolhida (o fundo azul) o texto vira o da linha - cinza, vermelho ou
    amarelo em cima do azul não dava pra ler
  -->
  <Style
    x:Key="ToneText.Cell"
    BasedOn="{StaticResource ToneText}"
    TargetType="TextBlock">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--  Bolinha do estado (o Tone da linha): verde concluído, azul rodando, vermelho erro, amarelo cancelado  -->
  <Style x:Key="ToneDot" TargetType="Ellipse">
    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Success}">
        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Warning}">
        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Error}">
        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--  A bolinha do projeto salvo: verde em dia, vermelha com desatualizado, nada se nunca foi conferido  -->
  <Style x:Key="ProjectDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasOutdated}" Value="True">
        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--  Pílula do estado em texto ("Rodando", "Com erro"): o fundo é a cor do estado apagada, o texto a cor cheia  -->
  <!--
    Pílula de estado: a letra do tamanho do texto da tabela (a de 10 sumia), 20 de altura e a palavra no meio - quem usa
    numa coluna dá a mesma largura pra todas (Width), e elas ficam alinhadas umas com as outras.
  -->
  <Style x:Key="TonePill" TargetType="Border">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Background" Value="{StaticResource Selection.RowBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Style.Resources>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Muted}">
        <Setter Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Success}">
        <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Error}">
        <Setter Property="Background" Value="{StaticResource Danger.SoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Warning}">
        <Setter Property="Background" Value="{StaticResource Warning.SoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--  Cartão de número (o KPI do Negativo): rótulo pequeno em cima, número grande embaixo  -->
  <Style
    x:Key="StatCard"
    BasedOn="{StaticResource SurfaceCard}"
    TargetType="Border">
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!--
    Linha de lista que abre alguma coisa (os batches), dentro de um cartão cinza: o fundo da tela, sem borda, o raio dos
    cartões, e a setinha no fim - o jeito do cartão de Configurações do Windows 11 de dizer "clica aqui". O hover
    clareia; a escolhida fica no azul apagado das tabelas, com a setinha azul.
  -->
  <Style x:Key="LinkListItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="{StaticResource Radius.Lg}" />
            <Border
              x:Name="Item"
              MinHeight="36"
              Padding="12,0,10,0"
              Background="Transparent"
              CornerRadius="{StaticResource Radius.Lg}">
              <DockPanel>
                <Path
                  x:Name="Chevron"
                  Width="10"
                  Height="10"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  Data="{icons:Phosphor CaretRightBold}"
                  DockPanel.Dock="Right"
                  Fill="{DynamicResource ThirdlyTextBrush}"
                  Stretch="Uniform" />
                <ContentPresenter VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter TargetName="Chevron" Property="Fill" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{StaticResource Selection.RowBrush}" />
              <Setter TargetName="Chevron" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ===== BARRA DE COMANDOS =====
    Em cima de toda tabela: o filtro (OptionGroup) à esquerda e a ação da tabela à direita, tudo com 28. 16 até o que vem
    antes, 8 até a tabela.
  -->
  <Style x:Key="CommandBar" TargetType="DockPanel">
    <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
    <Setter Property="Margin" Value="0,16,0,8" />
  </Style>

  <!--
    ===== SEÇÃO DE FORMULÁRIO =====
    A linha do título da seção (o Exportar: o quê, formatos, destino): altura pequena, o título em caixa alta e, à
    direita, as ações da seção. Sem número de passo (fica com cara de tutorial). Seções separadas por 16, o que é da
    seção por 8.
  -->
  <Style x:Key="SectionHeader" TargetType="DockPanel">
    <Setter Property="MinHeight" Value="{StaticResource Control.Height.Small}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!--
    Opções lado a lado (formatos, filtros): o hc:ButtonGroup do HandyControl com Layout Uniform - todos os segmentos
    da mesma largura, o primeiro e o último com o raio. O marcado fica cheio de azul, como o resto do app.
  -->
  <Style
    x:Key="OptionGroup"
    BasedOn="{StaticResource ButtonGroupSolid}"
    TargetType="hc:ButtonGroup">
    <Setter Property="Layout" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="hc:VisualElement.HighlightBorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="hc:VisualElement.HighlightBackground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="hc:VisualElement.HighlightForeground" Value="White" />
  </Style>

  <!--
    Chip de linha de formulário (as pastas das Versões, ao lado do botão Pasta): retângulo da altura do botão, cinza
    em cima da página, com o X no fim.
  -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource Control.Height}" />
    <Setter Property="Padding" Value="8,0,2,0" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}" />
    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Sm}" />
  </Style>

  <!--  Uma linha de lista que é um botão (o batch de hoje no Início): uma linha de 32 com o hover cinza  -->
  <Style x:Key="ListRowButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Item"
            MinHeight="32"
            Padding="12,0"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Md}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ===== TAG (a do HandyControl: hc:Tag) =====
    Pílula baixa com o texto e o X no fim, pra lista de coisas escolhidas (números do Exportar, pastas das Versões).
    Mora dentro de uma caixa, então tem a altura pequena. TagToggle liga e desliga num clique:
    desligada é o fundo cinza, ligada o azul cheio com o texto branco. O X é o Tag.Close, que pega a cor do texto.
  -->
  <Style x:Key="TagToggle" TargetType="ToggleButton">
    <Setter Property="Height" Value="{StaticResource Control.Height.Small}" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border
            x:Name="Bd"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="{StaticResource Radius.Tag}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  O X da tag: a cor do texto em volta (branco na tag ligada), um pouco apagado  -->
  <Style
    x:Key="Tag.Close"
    BasedOn="{StaticResource Action.Icon.Inline}"
    TargetType="Button">
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=FrameworkElement}}" />
  </Style>

  <!--
    Item da navegação do painel lateral (o NavigationView da Microsoft, modo Left): ícone no Tag (Geometry), o texto e
    o contador (NavBadge). O aberto ganha o fundo cinza e a barrinha azul à esquerda. Com o painel recolhido
    (PaneCompact do shell) fica só o ícone, no meio do item (o padding sai, senão a coluna de 36 corta o ícone), o
    contador vira bolinha e o nome vai pro tooltip.
    SideNavItem é o RadioButton das telas; SideNavButton, o mesmo visual num botão (Configurações, no rodapé).
  -->
  <Style x:Key="SideNavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border
              x:Name="Item"
              Height="{StaticResource Nav.ItemHeight}"
              Padding="10,0"
              Background="Transparent"
              CornerRadius="{StaticResource Radius.Md}">
              <!--  A linha na altura do item: o ícone fica sempre a 8 px do topo. Centrada, ela tinha a altura do texto e
                    perdia ao recolher; o ícone mais largo que alto (o da Estrutura) caía num meio pixel e pulava 1 px  -->
              <Grid x:Name="Row">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path
                  x:Name="Icon"
                  Width="{StaticResource Icon.Size.Nav}"
                  Height="{StaticResource Icon.Size.Nav}"
                  Data="{TemplateBinding Tag}"
                  Fill="{TemplateBinding Foreground}"
                  Stretch="Uniform" />
                <ContentPresenter
                  x:Name="Label"
                  Grid.Column="1"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center" />
                <Border
                  x:Name="Badge"
                  Grid.Column="2"
                  Height="18"
                  MinWidth="18"
                  Margin="8,0,0,0"
                  Padding="5,0"
                  Background="{DynamicResource PrimaryBrush}"
                  CornerRadius="9">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSize.XS}"
                    Foreground="White"
                    Text="{Binding (controls:NavBadge.Count), RelativeSource={RelativeSource TemplatedParent}}" />
                </Border>
                <!--  Recolhido: o contador vira uma bolinha no canto do ícone  -->
                <Ellipse
                  x:Name="Dot"
                  Width="7"
                  Height="7"
                  Margin="0,5,-3,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Fill="{Binding Background, ElementName=Badge}"
                  Visibility="Collapsed" />
              </Grid>
            </Border>
            <Border
              x:Name="Bar"
              Width="3"
              Height="16"
              HorizontalAlignment="Left"
              Background="{DynamicResource PrimaryBrush}"
              CornerRadius="2"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="controls:NavBadge.IsAlert" Value="True">
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding DataContext.PaneCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter TargetName="Item" Property="Padding" Value="0" />
              <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="controls:NavBadge.Count" Value="0">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding DataContext.PaneCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SideNavButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border
              x:Name="Item"
              Height="{StaticResource Nav.ItemHeight}"
              Padding="10,0"
              Background="Transparent"
              CornerRadius="{StaticResource Radius.Md}">
              <!--  A linha na altura do item: o ícone fica sempre a 8 px do topo. Centrada, ela tinha a altura do texto e
                    perdia ao recolher; o ícone mais largo que alto (o da Estrutura) caía num meio pixel e pulava 1 px  -->
              <Grid x:Name="Row">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path
                  x:Name="Icon"
                  Width="{StaticResource Icon.Size.Nav}"
                  Height="{StaticResource Icon.Size.Nav}"
                  Data="{TemplateBinding Tag}"
                  Fill="{TemplateBinding Foreground}"
                  Stretch="Uniform" />
                <ContentPresenter
                  x:Name="Label"
                  Grid.Column="1"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center" />
                <Border
                  x:Name="Badge"
                  Grid.Column="2"
                  Height="18"
                  MinWidth="18"
                  Margin="8,0,0,0"
                  Padding="5,0"
                  Background="{DynamicResource PrimaryBrush}"
                  CornerRadius="9">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSize.XS}"
                    Foreground="White"
                    Text="{Binding (controls:NavBadge.Count), RelativeSource={RelativeSource TemplatedParent}}" />
                </Border>
                <!--  Recolhido: o contador vira uma bolinha no canto do ícone  -->
                <Ellipse
                  x:Name="Dot"
                  Width="7"
                  Height="7"
                  Margin="0,5,-3,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Fill="{Binding Background, ElementName=Badge}"
                  Visibility="Collapsed" />
              </Grid>
            </Border>
            <Border
              x:Name="Bar"
              Width="3"
              Height="16"
              HorizontalAlignment="Left"
              Background="{DynamicResource PrimaryBrush}"
              CornerRadius="2"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="controls:NavBadge.IsAlert" Value="True">
              <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding DataContext.PaneCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter TargetName="Item" Property="Padding" Value="0" />
              <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="controls:NavBadge.Count" Value="0">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding DataContext.PaneCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--  O botão de recolher/abrir o painel lateral: do tamanho de um item, só o ícone  -->
  <Style
    x:Key="PaneToggle"
    BasedOn="{StaticResource Action.Icon.Small}"
    TargetType="Button">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="{StaticResource Nav.ItemHeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="hc:IconElement.Width" Value="{StaticResource Icon.Size.Nav}" />
    <Setter Property="hc:IconElement.Height" Value="{StaticResource Icon.Size.Nav}" />
  </Style>

  <!--  Projeto salvo na lista do painel lateral: a mesma cara do item de navegação, mais baixo  -->
  <Style x:Key="ProjectItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            x:Name="Item"
            Height="{StaticResource Nav.ItemHeight}"
            Padding="12,0"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Md}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Nav.SelectedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Barra de progresso fina, só o trilho e o preenchimento azul: a do HandyControl escreve a porcentagem no meio, que
    numa barra de 6 px vira um borrão. Sem saber o total (zip do GitHub), o preenchimento inteiro pulsa.
  -->
  <Style x:Key="SlimProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <!--  O BorderBrush do HandyControl quase some em cima do cartão translúcido: o trilho é branco fraco, como as divisórias  -->
    <Setter Property="Background" Value="{DynamicResource Progress.TrackBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border
              x:Name="PART_Track"
              Background="{TemplateBinding Background}"
              CornerRadius="3" />
            <Border
              x:Name="PART_Indicator"
              HorizontalAlignment="Left"
              Background="{TemplateBinding Foreground}"
              CornerRadius="3" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Pulse">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation
                      AutoReverse="True"
                      Storyboard.TargetName="PART_Indicator"
                      Storyboard.TargetProperty="Opacity"
                      From="0.25"
                      To="0.8"
                      Duration="0:0:0.7" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Pulse" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Toda barra de progresso do app é a fina  -->
  <Style BasedOn="{StaticResource SlimProgress}" TargetType="ProgressBar" />

  <!--
    A camada por cima do Mica (o jeito da Связь e do Windows 11): branco translúcido em vez de cinza sólido, pro fundo
    da área de trabalho atravessar. Sem Mica (Windows 10 ou desligado) a janela volta pro RegionBrush e esta camada dá
    quase o mesmo cinza de antes.
  -->
  <SolidColorBrush x:Key="Pane.BackgroundBrush" Color="#12FFFFFF" />

  <!--
    As camadas da Связь, sem borda dura em lugar nenhum: o painel fica direto no Mica, a tela é uma camada um pouco
    mais clara (Pane.BackgroundBrush) e os cartões mais uma por cima (Card.BackgroundBrush). Divisória é uma linha de
    branco bem fraco, não a cor de borda do HandyControl.
  -->
  <SolidColorBrush x:Key="Card.BackgroundBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Divider.Brush" Color="#14FFFFFF" />
  <!--  As linhas da tabela, um degrau abaixo da divisória: são muitas, então bem fracas  -->
  <SolidColorBrush x:Key="Grid.DividerBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="Progress.TrackBrush" Color="#1AFFFFFF" />
  <!--  Menu que abre por cima (a lista do SelectField): o cinza do menu do Windows 11, um degrau acima da janela  -->
  <SolidColorBrush x:Key="Flyout.BackgroundBrush" Color="#2B2B2E" />
  <SolidColorBrush x:Key="Flyout.BorderBrush" Color="#1FFFFFFF" />
  <!--  Botão sem borda: fundo translúcido sobre a camada, mais claro no hover, mais apagado apertado  -->
  <SolidColorBrush x:Key="Button.BackgroundBrush" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="Button.HoverBrush" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="Button.PressedBrush" Color="#0EFFFFFF" />
  <SolidColorBrush x:Key="Nav.SelectedBrush" Color="#1AFFFFFF" />
  <!--  Os fundos suaves dos ícones (a cor do estado bem apagada)  -->
  <SolidColorBrush x:Key="Accent.SoftBrush" Color="#2E3778BF" />
  <SolidColorBrush x:Key="Success.SoftBrush" Color="#2633C467" />

  <!--  Cartão de informação da Связь: linhas "rótulo ..... valor [ação]" com divisória fina entre elas  -->
  <Style x:Key="InfoCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,2" />
  </Style>

  <Style x:Key="InfoRow" TargetType="DockPanel">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="LastChildFill" Value="True" />
  </Style>

  <Style x:Key="InfoLabel" TargetType="TextBlock">
    <Setter Property="Width" Value="110" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="InfoValue" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="InfoDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Divider.Brush}" />
  </Style>

  <!--
    Configurações no jeito do cartão de informação da Связь: um cartão translúcido por seção (SettingGroup), com o
    título da seção em cima e as opções dentro (SettingRow), separadas pela divisória fina (InfoDivider). Cada opção
    tem título e explicação à esquerda e o controle à direita.
  -->
  <Style x:Key="SettingGroup" TargetType="Border">
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style x:Key="SettingRow" TargetType="Border">
    <Setter Property="Padding" Value="0,10" />
  </Style>

  <Style x:Key="SettingTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SettingCaption" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SettingSection" TargetType="TextBlock">
    <Setter Property="Margin" Value="2,14,0,6" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.XS}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <!--
    Chave liga/desliga (a da Связь): trilho 36x20 branco fraco / azul, bolinha branca deslizando em 150 ms. O
    ToggleButtonSwitch do HandyControl sumia no cartão translúcido quando desligado.
  -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border
              x:Name="Track"
              Background="#33FFFFFF"
              CornerRadius="10" />
            <Ellipse
              Width="14"
              Height="14"
              Margin="3,0"
              HorizontalAlignment="Left"
              Fill="White">
              <Ellipse.RenderTransform>
                <TranslateTransform x:Name="KnobMove" X="0" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="KnobMove"
                      Storyboard.TargetProperty="X"
                      To="16"
                      Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="KnobMove"
                      Storyboard.TargetProperty="X"
                      To="0"
                      Duration="0:0:0.15">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
