<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:Provodnik.Wpf.Shared.Behaviors"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons">

  <!--
    A grade do rnzNegativeObserver (o StandardDataGrid do Windfinder): fundo cinza, raio Lg, sem borda, linha pequena
    do HandyControl e o botão direito de copiar/exportar. Mais o degradê do ScrollFade embaixo (as últimas linhas
    somem em vez de aparecerem cortadas). Sem o filtro por coluna do DataGridFilter: aqui a caixa de filtro de cima
    (QuickFilter) faz o serviço.
  -->

  <!--  Alça de arrastar a largura da coluna: invisível, só o cursor de redimensionar  -->
  <Style x:Key="ColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="8" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Cabeçalho com a mesma linha fraca das células: separador na direita (no mesmo x) e a linha de baixo. A última
    coluna e o pedaço que sobra depois dela ficam sem o da direita. Template próprio pra seta de ordenar ser o caret
    do Phosphor (a do HandyControl era um triângulo de outro traço), logo depois do nome; a coluna ordenada fica azul.
  -->
  <Style
    x:Key="StandardColumnHeader"
    BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}"
    TargetType="DataGridColumnHeader">
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Grid.DividerBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              SnapsToDevicePixels="True">
              <StackPanel
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Orientation="Horizontal">
                <ContentPresenter
                  VerticalAlignment="Center"
                  RecognizesAccessKey="True"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <Path
                  x:Name="SortIcon"
                  Width="9"
                  Height="9"
                  Margin="6,1,0,0"
                  VerticalAlignment="Center"
                  Data="{icons:Phosphor CaretUpBold}"
                  Fill="{TemplateBinding Foreground}"
                  RenderTransformOrigin="0.5,0.5"
                  Stretch="Uniform"
                  Visibility="Collapsed">
                  <Path.RenderTransform>
                    <RotateTransform />
                  </Path.RenderTransform>
                </Path>
              </StackPanel>
            </Border>
            <Thumb
              x:Name="PART_LeftHeaderGripper"
              Margin="-4,0,0,0"
              HorizontalAlignment="Left"
              Style="{StaticResource ColumnHeaderGripper}" />
            <Thumb
              x:Name="PART_RightHeaderGripper"
              Margin="0,0,-4,0"
              HorizontalAlignment="Right"
              Style="{StaticResource ColumnHeaderGripper}" />
          </Grid>
          <ControlTemplate.Triggers>
            <!--
              Um caret só, que gira meia volta quando a ordem inverte (o giro da setinha do SelectField do Windfinder).
              O giro mora inteiro no gatilho do decrescente (entra: 180, sai: 0): com um storyboard em cada gatilho, o
              do gatilho de baixo continuava valendo e a volta pro crescente não girava. O atraso de 80 ms é a ordenação:
              ela segura a tela uns 100 ms, e sem ele o giro já acabava antes do primeiro quadro.
            -->
            <Trigger Property="SortDirection" Value="Ascending">
              <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
              <Setter TargetName="SortIcon" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="SortIcon"
                      Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                      BeginTime="0:0:0.08"
                      To="180"
                      Duration="0:0:0.3">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="SortIcon"
                      Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                      BeginTime="0:0:0.08"
                      To="0"
                      Duration="0:0:0.3">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="SortDirection" Value="Ascending">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      </Trigger>
      <Trigger Property="SortDirection" Value="Descending">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      </Trigger>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <MultiBinding Converter="{StaticResource IsLastColumn}">
            <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
            <Binding Path="DisplayIndex" RelativeSource="{RelativeSource Self}" />
            <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" />
          </MultiBinding>
        </DataTrigger.Binding>
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!--
    Linha sem o azul cheio do HandyControl (em cima dele a pílula e o texto azul sumiam): o destaque é um fundo
    arredondado solto das bordas, branco bem fraco no hover e o azul suave na escolhida. A divisória
    entre as linhas fica embaixo e fora do destaque, recuada das pontas.
  -->
  <Style
    x:Key="StandardDataGridRow"
    BasedOn="{StaticResource DataGridRowStyle.Small}"
    TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <!--  O estilo do HandyControl dá uma margem em cima: o destaque ficava mais longe da linha de cima que da de baixo  -->
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
              Margin="3,2,3,3"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource Radius.Sm}" />
            <DataGridCellsPresenter
              Margin="0,0,0,1"
              ItemsPanel="{TemplateBinding ItemsPanel}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <DataGridDetailsPresenter
              Grid.Row="1"
              Margin="0,0,0,1"
              Visibility="{TemplateBinding DetailsVisibility}" />
            <Border
              Grid.RowSpan="2"
              Height="1"
              Margin="8,0"
              VerticalAlignment="Bottom"
              Background="{DynamicResource Grid.DividerBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Hover.RowBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Selection.RowBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Célula transparente (o fundo é o da linha), texto sempre na cor normal. O separador de coluna é desenhado aqui,
    da altura inteira da linha (emenda com o de cima e o de baixo numa linha só); só a última coluna sai sem.
  -->
  <Style
    x:Key="StandardDataGridCell"
    BasedOn="{StaticResource DataGridCellStyle.Small}"
    TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <Border
              x:Name="Separator"
              Width="1"
              HorizontalAlignment="Right"
              Background="{DynamicResource Grid.DividerBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True">
              <DataTrigger.Binding>
                <MultiBinding Converter="{StaticResource IsLastColumn}">
                  <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
                  <Binding Path="Column.DisplayIndex" RelativeSource="{RelativeSource Self}" />
                  <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                  <Binding Path="Column.Visibility" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </DataTrigger.Binding>
              <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style
    x:Key="StandardDataGrid"
    BasedOn="{StaticResource DataGrid.Small}"
    TargetType="DataGrid">
    <!--  Botão direito: copiar a tabela / exportar CSV  -->
    <Setter Property="behaviors:DataGridExport.IsEnabled" Value="True" />
    <!--  Mais linhas embaixo: as últimas somem num degradê, sem linha cortada ao meio  -->
    <Setter Property="behaviors:ScrollFade.IsEnabled" Value="True" />

    <Setter Property="ColumnHeaderStyle" Value="{StaticResource StandardColumnHeader}" />
    <Setter Property="CellStyle" Value="{StaticResource StandardDataGridCell}" />
    <Setter Property="RowStyle" Value="{StaticResource StandardDataGridRow}" />

    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="True" />
    <Setter Property="CanUserSortColumns" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />

    <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource Radius.Lg}" />
    <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}" />
    <!--  As linhas são das células e das linhas (acima), não da grade do DataGrid  -->
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="BorderThickness" Value="0" />

    <Setter Property="EnableColumnVirtualization" Value="True" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
  </Style>

</ResourceDictionary>
