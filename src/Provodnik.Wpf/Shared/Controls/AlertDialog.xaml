<UserControl
  x:Class="Provodnik.Wpf.Shared.Controls.AlertDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:Provodnik.Wpf.Shared.Localization"
  Width="380"
  MinHeight="150"
  Background="Transparent">

  <!--
    Diálogo de aviso/confirmação (o AlertDialog do rnzNegativeObserver): ícone colorido e título, a mensagem,
    "ver detalhes" que abre o texto técnico ali mesmo (erro inteiro, com botão de copiar) e o rodapé cinza com os
    botões. Enter = principal, Esc = secundário. Quem abre é o DialogService.
  -->
  <Border
    Background="{DynamicResource RegionBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="1"
    Effect="{StaticResource Shadow.Card}"
    Style="{StaticResource DialogBorderAnimated}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Margin="24,20,24,16">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
          <Path
            x:Name="HeaderIcon"
            Width="20"
            Height="20"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Stretch="Uniform" />
          <TextBlock
            x:Name="TitleText"
            VerticalAlignment="Center"
            FontSize="{StaticResource FontSize.Lg}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryTextBrush}"
            TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock
          x:Name="MessageText"
          Margin="0,12,0,0"
          HorizontalAlignment="Center"
          FontSize="{StaticResource FontSize.Md}"
          Foreground="{DynamicResource SecondaryTextBrush}"
          TextAlignment="Center"
          TextWrapping="Wrap" />

        <TextBlock
          x:Name="DetailsLink"
          Margin="0,8,0,0"
          HorizontalAlignment="Center"
          FontSize="{StaticResource FontSize.Sm}"
          Visibility="Collapsed">
          <Hyperlink Click="DetailsLink_Click" Foreground="{DynamicResource PrimaryBrush}">
            <Run x:Name="DetailsLinkText" Text="{loc:Tr shared.details.show}" />
          </Hyperlink>
        </TextBlock>

        <TextBox
          x:Name="DetailsBox"
          MaxHeight="220"
          Margin="0,10,0,0"
          Padding="8"
          HorizontalScrollBarVisibility="Disabled"
          FontFamily="{StaticResource FontFamily.Numbers}"
          FontSize="{StaticResource FontSize.XS}"
          IsReadOnly="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
          Visibility="Collapsed" />
      </StackPanel>

      <Border
        Grid.Row="1"
        Padding="24,12"
        Background="{DynamicResource SecondaryRegionBrush}"
        CornerRadius="0,0,11,11">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
          <Button
            x:Name="CopyButton"
            Margin="0,0,10,0"
            Click="CopyButton_Click"
            Content="{loc:Tr shared.copy}"
            Style="{StaticResource Action.Dialog}"
            Visibility="Collapsed" />
          <Button
            x:Name="SecondaryButton"
            Margin="0,0,10,0"
            Click="SecondaryButton_Click"
            Style="{StaticResource Action.Dialog}"
            Visibility="Collapsed" />
          <Button
            x:Name="PrimaryButton"
            Click="PrimaryButton_Click"
            Style="{StaticResource Action.Dialog.Primary}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
