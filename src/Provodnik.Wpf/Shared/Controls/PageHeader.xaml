<UserControl
  x:Class="Provodnik.Wpf.Shared.Controls.PageHeader"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Name="Root">

  <!--
    O cabeçalho de toda página: o título (o HeadFontSize do HandyControl, 20), uma linha do que a página faz e, à direita,
    as ações dela, alinhadas pela base do texto. Embaixo, 16 até o conteúdo - a mesma régua das margens.

    <controls:PageHeader Title="..." Subtitle="...">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal"> ...botões... </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>
  -->
  <DockPanel MinHeight="44" Margin="0,0,0,16">
    <ContentPresenter
      Margin="16,0,0,0"
      VerticalAlignment="Bottom"
      Content="{Binding Actions, ElementName=Root}"
      DockPanel.Dock="Right" />
    <StackPanel VerticalAlignment="Bottom">
      <TextBlock
        FontSize="{StaticResource HeadFontSize}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Text="{Binding Title, ElementName=Root}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        Margin="0,2,0,0"
        Style="{StaticResource CaptionText}"
        Text="{Binding Subtitle, ElementName=Root}"
        Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource String2VisibilityConverter}}" />
    </StackPanel>
  </DockPanel>
</UserControl>
