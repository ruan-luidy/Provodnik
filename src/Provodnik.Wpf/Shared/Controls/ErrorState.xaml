<UserControl
  x:Class="Provodnik.Wpf.Shared.Controls.ErrorState"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  x:Name="Root"
  MaxWidth="460"
  HorizontalAlignment="Center"
  VerticalAlignment="Center"
  IsTabStop="False"
  Visibility="Collapsed">

  <!--
    A página não carregou: um cartão flutuante no meio (a sombra e o contorno do que flutua, como o menu do usuário),
    com o aviso, o motivo (inteiro no tooltip) e o Tentar de novo. Some sozinho enquanto o Text estiver vazio:

      <controls:ErrorState RetryCommand="{Binding RetryCommand}" Text="{Binding ErrorMessage}" />
  -->
  <Grid Margin="{StaticResource PopupShadowRoom}">
    <Border Style="{StaticResource PopupShadow}" />
    <Border Padding="20,16" Style="{StaticResource PopupCard}">
      <StackPanel>
        <DockPanel>
          <Path
            Width="{StaticResource Icon.Size.Nav}"
            Height="{StaticResource Icon.Size.Nav}"
            Margin="0,1,12,0"
            VerticalAlignment="Top"
            Data="{icons:Phosphor WarningBold}"
            Fill="{DynamicResource WarningBrush}"
            Stretch="Uniform" />
          <TextBlock
            Foreground="{DynamicResource PrimaryTextBrush}"
            Text="{Binding Text, ElementName=Root}"
            TextWrapping="Wrap"
            ToolTip="{Binding ToolTipText, ElementName=Root}" />
        </DockPanel>
        <Button
          x:Name="RetryButton"
          Margin="0,16,0,0"
          HorizontalAlignment="Right"
          hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}"
          Command="{Binding RetryCommand, ElementName=Root}"
          Content="Tentar de novo"
          Style="{StaticResource Action}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
