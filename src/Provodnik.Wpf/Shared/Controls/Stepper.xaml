<UserControl
  x:Class="Provodnik.Wpf.Shared.Controls.Stepper"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  x:Name="Root"
  Height="{StaticResource Control.Height}">

  <UserControl.Resources>
    <!--
      O "−" e o "+": o fundo arredondado e o ícone são uma peça só (o ícone vai no Tag) - clareia no hover e encolhe
      inteira no clique, o "afundar" dos botões do Negativo. O botão de ícone do HandyControl tinha 24 numa caixa de
      28 e o realce não acompanhava o ícone.
    -->
    <Style x:Key="StepButton" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform />
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="3">
              <Path
                Width="10"
                Height="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                Fill="{TemplateBinding Foreground}"
                Stretch="Uniform" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Button.HoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource Button.PressedBrush}" />
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                  To="0.9"
                  Duration="0:0:0.10" />
                <DoubleAnimation
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                  To="0.9"
                  Duration="0:0:0.10" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                  To="1"
                  Duration="0:0:0.10" />
                <DoubleAnimation
                  Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                  To="1"
                  Duration="0:0:0.10" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!--  "−  3  +" no fundo translúcido dos botões: o número no meio, os botões nas pontas  -->
  <Border Background="{DynamicResource Button.BackgroundBrush}" CornerRadius="{StaticResource Radius.Sm}">
    <DockPanel>
      <Button
        x:Name="Down"
        Click="Down_Click"
        DockPanel.Dock="Left"
        Style="{StaticResource StepButton}"
        Tag="{icons:Phosphor MinusBold}" />
      <Button
        x:Name="Up"
        Click="Up_Click"
        DockPanel.Dock="Right"
        Style="{StaticResource StepButton}"
        Tag="{icons:Phosphor PlusBold}" />
      <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontFamily="{StaticResource FontFamily.Numbers}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Text="{Binding Value, ElementName=Root}" />
    </DockPanel>
  </Border>
</UserControl>
