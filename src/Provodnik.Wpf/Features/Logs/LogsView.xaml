<UserControl
  x:Class="Provodnik.Wpf.Features.Logs.LogsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:Provodnik.Wpf.Shared.Behaviors"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:logs="clr-namespace:Provodnik.Wpf.Features.Logs"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="clr-namespace:Provodnik.Wpf.Shared.Services"
  xmlns:shared="clr-namespace:Provodnik.Wpf.Shared"
  d:DataContext="{d:DesignInstance Type=logs:LogsViewModel}"
  mc:Ignorable="d">

  <UserControl.Resources>
    <!--
      Chip de filtro (Tudo / Avisos / Erros): o jeito dos botões, sem borda e translúcido; o escolhido no azul suave.
      O número fica do lado, mais apagado.
    -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
      <Setter Property="Height" Value="{StaticResource Control.Height}" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource Button.BackgroundBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Chip"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              CornerRadius="{StaticResource Radius.Sm}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Button.HoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!--
      Linha da lista de registros ("Esta sessão" e as instalações de antes): sem caixa própria, o realce fraco no hover e
      o azul suave na escolhida, como as linhas da grade; a bolinha diz como a instalação terminou.
    -->
    <Style x:Key="LogSourceItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border
              x:Name="Item"
              Padding="10,7"
              Background="Transparent"
              CornerRadius="{StaticResource Radius.Md}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Item" Property="Background" Value="{StaticResource Selection.RowBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChipCount" TargetType="TextBlock">
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Sm}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <!--
      Etiqueta de nível na linha: a pílula da cor do nível, todas da mesma largura e da altura da primeira linha do
      texto, com a palavra no meio; info não tem
    -->
    <Style
      x:Key="LevelPill"
      BasedOn="{StaticResource TonePill}"
      TargetType="Border">
      <Setter Property="Width" Value="50" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="TextElement.FontSize" Value="11" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding LevelText}" Value="">
          <Setter Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="Registro" Subtitle="O que aconteceu nesta sessão e nas instalações de antes (.provodnik\logs).">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor CopyBold}"
            Command="{Binding CopyCommand}"
            Content="Copiar"
            Style="{StaticResource Action}"
            ToolTip="Copia as linhas que estão aparecendo (com o filtro)" />
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor TrashBold}"
            Command="{Binding ClearCommand}"
            Content="Limpar"
            IsEnabled="{Binding IsSession}"
            Style="{StaticResource Action}"
            ToolTip="Limpa o registro desta sessão (os arquivos ficam)" />
          <Button
            hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
            Command="{Binding OpenFolderCommand}"
            Content="Pasta dos logs"
            Style="{StaticResource Action}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  ===== Qual registro: o desta sessão, ao vivo, e os arquivos das instalações de antes =====  -->
      <Border Padding="8" Style="{StaticResource SurfaceCard}">
        <DockPanel>
          <TextBlock
            Margin="6,4,0,8"
            DockPanel.Dock="Top"
            Style="{StaticResource StatLabel}"
            Text="AGORA" />
          <Button
            Margin="0,0,0,12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="Esta sessão"
            Command="{Binding ShowSessionCommand}"
            Cursor="Hand"
            DockPanel.Dock="Top">
            <!--  O mesmo desenho das linhas da lista de baixo (LogSourceItem), escolhida quando é a sessão  -->
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border
                  x:Name="Item"
                  Padding="10,8"
                  Background="Transparent"
                  CornerRadius="{StaticResource Radius.Md}">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding IsSession}" Value="True">
                    <Setter TargetName="Item" Property="Background" Value="{StaticResource Selection.RowBrush}" />
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <DockPanel>
              <Ellipse
                Width="7"
                Height="7"
                Margin="0,0,9,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Fill="{DynamicResource SuccessBrush}" />
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Style="{StaticResource ChipCount}"
                Text="{Binding DataContext.Total, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Visibility="{Binding IsSession, Converter={StaticResource Boolean2VisibilityConverter}}" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="Esta sessão" />
            </DockPanel>
          </Button>

          <TextBlock
            Margin="6,0,0,8"
            DockPanel.Dock="Top"
            Style="{StaticResource StatLabel}"
            Text="INSTALAÇÕES DE ANTES" />
          <Grid>
            <ListBox
              Background="Transparent"
              BorderThickness="0"
              behaviors:ScrollFade.IsEnabled="True"
              ItemContainerStyle="{StaticResource LogSourceItem}"
              ItemsSource="{Binding Files}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              SelectedItem="{Binding SelectedFile}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type logs:LogFile}">
                  <DockPanel>
                    <Ellipse
                      Width="7"
                      Height="7"
                      Margin="0,6,9,0"
                      VerticalAlignment="Top"
                      DockPanel.Dock="Left"
                      Style="{StaticResource ToneDot}" />
                    <StackPanel>
                      <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title}" />
                      <TextBlock
                        Margin="0,1,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding Caption}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock
              Margin="6,0"
              Style="{StaticResource CaptionText}"
              Text="Nenhuma ainda."
              Visibility="{Binding Files.Count, Converter={StaticResource WhenEmpty}}" />
          </Grid>
        </DockPanel>
      </Border>

      <!--  ===== As linhas =====  -->
      <DockPanel Grid.Column="2">
        <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <RadioButton IsChecked="{Binding Filter, Converter={StaticResource Is}, ConverterParameter={x:Static logs:LogFilter.All}}" Style="{StaticResource FilterChip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tudo" />
                <TextBlock Style="{StaticResource ChipCount}" Text="{Binding Total}" />
              </StackPanel>
            </RadioButton>
            <RadioButton IsChecked="{Binding Filter, Converter={StaticResource Is}, ConverterParameter={x:Static logs:LogFilter.Warnings}}" Style="{StaticResource FilterChip}">
              <StackPanel Orientation="Horizontal">
                <Ellipse
                  Width="7"
                  Height="7"
                  Margin="0,0,7,0"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource WarningBrush}" />
                <TextBlock Text="Avisos" />
                <TextBlock Style="{StaticResource ChipCount}" Text="{Binding Warnings}" />
              </StackPanel>
            </RadioButton>
            <RadioButton IsChecked="{Binding Filter, Converter={StaticResource Is}, ConverterParameter={x:Static logs:LogFilter.Errors}}" Style="{StaticResource FilterChip}">
              <StackPanel Orientation="Horizontal">
                <Ellipse
                  Width="7"
                  Height="7"
                  Margin="0,0,7,0"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource DangerBrush}" />
                <TextBlock Text="Erros" />
                <TextBlock Style="{StaticResource ChipCount}" Text="{Binding Errors}" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
          <hc:TextBox
            Width="280"
            HorizontalAlignment="Left"
            hc:InfoElement.Placeholder="Buscar no registro"
            Style="{StaticResource FilterBox}"
            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"
            ToolTip="Mostra só as linhas com esse texto" />
        </DockPanel>

        <Border Padding="6" Style="{StaticResource SurfaceCard}">
          <Grid>
            <ListBox
              x:Name="List"
              Background="Transparent"
              BorderThickness="0"
              behaviors:ScrollFade.IsEnabled="True"
              ItemsSource="{Binding Lines}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.ScrollUnit="Pixel"
              VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <!--  Linha com o realce fraco no hover, cantos Sm; sem seleção (é só leitura, o Copiar pega tudo)  -->
                <Style TargetType="ListBoxItem">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border
                          x:Name="Row"
                          Padding="8,5"
                          Background="Transparent"
                          CornerRadius="{StaticResource Radius.Sm}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover.RowBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <!--
                  A hora em cinza legível, a pílula do nível (aviso, erro, pronto; info sem) e o texto na cor normal,
                  quebrando linha. Linha toda colorida em negrito cansa a vista quando são centenas.
                -->
                <DataTemplate DataType="{x:Type services:LogLine}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="66" />
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      Margin="0,1,0,0"
                      VerticalAlignment="Top"
                      FontFamily="{StaticResource FontFamily.Numbers}"
                      FontSize="{StaticResource FontSize.Sm}"
                      Foreground="{DynamicResource SecondaryTextBrush}"
                      Text="{Binding TimeText}" />
                    <Border Grid.Column="1" Style="{StaticResource LevelPill}">
                      <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding LevelText}" />
                    </Border>
                    <TextBlock
                      Grid.Column="2"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Text="{Binding Text}"
                      TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <controls:EmptyState
              Icon="{icons:Phosphor ScrollBold}"
              Text="Nada por aqui. Comece uma instalação e o passo a passo aparece."
              Visibility="{Binding Lines.Count, Converter={StaticResource WhenEmpty}, FallbackValue=Collapsed}" />
          </Grid>
        </Border>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
