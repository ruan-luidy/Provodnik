<UserControl
  x:Class="Provodnik.Wpf.Features.Mods.ModsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:Provodnik.Wpf.Shared.Behaviors"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:loc="clr-namespace:Provodnik.Wpf.Shared.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mods="clr-namespace:Provodnik.Wpf.Features.Mods"
  d:DataContext="{d:DesignInstance Type=mods:ModsViewModel}"
  mc:Ignorable="d">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="{loc:Tr mods.title}" Subtitle="{Binding Subtitle}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor SlidersHorizontalBold}"
            Command="{Binding OpenModOrganizerCommand}"
            Content="{loc:Tr mods.openMo2}"
            Style="{StaticResource Action}"
            ToolTip="{loc:Tr mods.openMo2.tip}" />
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}"
            Command="{Binding ReloadCommand}"
            Content="{loc:Tr mods.reload}"
            Style="{StaticResource Action}" />
          <Button
            hc:IconElement.Geometry="{icons:Phosphor MagicWandBold}"
            Command="{Binding ReinstallMissingCommand}"
            Content="{loc:Tr mods.fillEmpty}"
            IsEnabled="{Binding Install.IsRunning, Converter={StaticResource Boolean2BooleanReConverter}}"
            Style="{StaticResource Action.Primary}"
            ToolTip="{loc:Tr mods.fillEmpty.tip}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <!--  Faixa de filtro: a caixa que filtra qualquer coluna e o "só os vazios"  -->
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <hc:TextBox
        x:Name="Filter"
        Width="260"
        DockPanel.Dock="Left"
        hc:InfoElement.Placeholder="{loc:Tr mods.filter}"
        Style="{StaticResource FilterBox}" />
      <CheckBox
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        Content="{loc:Tr mods.onlyEmpty}"
        IsChecked="{Binding OnlyMissing}" />
    </DockPanel>

    <DataGrid
      Grid.Row="2"
      behaviors:QuickFilter.Text="{Binding Text, ElementName=Filter}"
      ItemsSource="{Binding Items}"
      SelectedItem="{Binding Selected}"
      Style="{StaticResource StandardDataGrid}">
      <DataGrid.Columns>
        <DataGridTextColumn
          Width="52"
          Binding="{Binding Index}"
          Header="#" />
        <DataGridTemplateColumn Width="*" Header="{loc:Tr mods.column.mod}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type mods:ModItemRow}">
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title, Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Author, Mode=OneWay, StringFormat=' · {0}'}" />
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn
          Width="84"
          Binding="{Binding Source}"
          Header="{loc:Tr mods.column.source}" />
        <DataGridTextColumn
          Width="190"
          Binding="{Binding ArchiveName}"
          Header="{loc:Tr mods.column.archive}" />
        <DataGridTextColumn
          Width="100"
          Binding="{Binding ArchiveText}"
          Header="{loc:Tr mods.column.downloaded}" />
        <DataGridTemplateColumn Width="100" Header="{loc:Tr mods.column.folder}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type mods:ModItemRow}">
              <Border
                Width="84"
                HorizontalAlignment="Left"
                Style="{StaticResource TonePill}"
                ToolTip="{Binding FolderHint}">
                <TextBlock Text="{Binding FolderText}" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn
          Width="180"
          Binding="{Binding Origin}"
          Header="{loc:Tr mods.column.installedBy}" />
        <DataGridTemplateColumn Width="96">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type mods:ModItemRow}">
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                  hc:IconElement.Geometry="{icons:Phosphor GlobeBold}"
                  Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  CommandParameter="{Binding}"
                  Style="{StaticResource Action.Icon.Small}"
                  ToolTip="{loc:Tr mods.openPage}" />
                <Button
                  hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                  Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  CommandParameter="{Binding}"
                  Style="{StaticResource Action.Icon.Small}"
                  ToolTip="{loc:Tr mods.openFolder}" />
                <Button
                  hc:IconElement.Geometry="{icons:Phosphor ArrowClockwiseBold}"
                  Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  CommandParameter="{Binding}"
                  Style="{StaticResource Action.Icon.Small}"
                  ToolTip="{loc:Tr mods.reinstall}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <controls:EmptyState
      Grid.Row="2"
      Icon="{icons:Phosphor PackageBold}"
      Text="{loc:Tr mods.empty}"
      Visibility="{Binding Items.Count, Converter={StaticResource WhenEmpty}}" />
  </Grid>
</UserControl>
