<UserControl
  x:Class="Provodnik.Wpf.Features.Install.ConsolePanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:services="clr-namespace:Provodnik.Wpf.Shared.Services">

  <!--
    O console das ferramentas, no fundo escuro de terminal: hora, a ferramenta e a linha crua. Erro conhecido fica
    vermelho e ganha embaixo, em amarelo, a linha "→" com o que quer dizer e o que fazer.
  -->
  <Border Padding="10,6" Background="#0F1012" CornerRadius="{StaticResource Radius.Md}">
    <ListBox
      x:Name="List"
      Background="Transparent"
      BorderThickness="0"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter Margin="0,0,0,1" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type services:ConsoleLine}">
          <DockPanel TextElement.FontFamily="{StaticResource FontFamily.Numbers}" TextElement.FontSize="{StaticResource FontSize.Sm}">
            <TextBlock
              Width="58"
              DockPanel.Dock="Left"
              Foreground="#5C6370"
              Text="{Binding TimeText}" />
            <TextBlock
              Width="62"
              DockPanel.Dock="Left"
              Foreground="#61AFEF"
              Text="{Binding Tool}" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="#ABB2BF" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:ConsoleKind.Error}">
                      <Setter Property="Foreground" Value="#E06C75" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:ConsoleKind.Hint}">
                      <Setter Property="Foreground" Value="#E5C07B" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Border>
</UserControl>
