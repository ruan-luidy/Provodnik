<UserControl
  x:Class="Provodnik.Wpf.Features.Install.InstallView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:core="clr-namespace:Provodnik.Core.Install;assembly=Provodnik.Core"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:install="clr-namespace:Provodnik.Wpf.Features.Install"
  xmlns:loc="clr-namespace:Provodnik.Wpf.Shared.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DataContext="{d:DesignInstance Type=install:InstallViewModel}"
  mc:Ignorable="d">

  <UserControl.Resources>
    <!--  O ícone da etapa pelo estado: círculo vazio na fila, carregando rodando, ✓ verde, ! amarelo, ✕ vermelho  -->
    <Style x:Key="StageIcon" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <!--  Pendente: o círculo vazio no cinza do texto secundário (o ThirdlyTextBrush sumia em cima do cartão)  -->
      <Setter Property="Data" Value="{icons:Phosphor CircleBold}" />
      <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="Opacity" Value="0.55" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StageState.Running}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StageState.Done}">
          <Setter Property="Data" Value="{icons:Phosphor CheckCircleFill}" />
          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StageState.Warning}">
          <Setter Property="Data" Value="{icons:Phosphor WarningCircleFill}" />
          <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StageState.Failed}">
          <Setter Property="Data" Value="{icons:Phosphor XCircleFill}" />
          <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StageState.Skipped}">
          <!--  Pulada (nada mudou desde a última vez): o traço, sem opacidade baixa - a etapa está certa  -->
          <Setter Property="Data" Value="{icons:Phosphor MinusCircleFill}" />
          <Setter Property="Opacity" Value="0.8" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--  O traço da linha do tempo, do ícone até a próxima etapa: verde quando a etapa terminou, nenhum na última  -->
    <Style x:Key="StageConnector" TargetType="Border">
      <Setter Property="Width" Value="2" />
      <Setter Property="Margin" Value="0,4,0,3" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Progress.TrackBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StageState.Done}">
          <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
          <Setter Property="Opacity" Value="0.45" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLast}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StageTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsRunning}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--  Número grande do resumo, com o rótulo pequeno embaixo  -->
    <Style x:Key="BigNumber" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="{loc:Tr install.title}" Subtitle="{Binding Service.Headline}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <CheckBox
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            Content="{loc:Tr install.forceExtract}"
            IsChecked="{Binding ForceExtract}"
            ToolTip="{loc:Tr install.forceExtract.tip}"
            Visibility="{Binding Service.IsRunning, Converter={StaticResource Boolean2VisibilityReConverter}}" />
          <ToggleButton
            Margin="0,0,4,0"
            hc:IconElement.Geometry="{icons:Phosphor TerminalWindowBold}"
            IsChecked="{Binding ShowConsole}"
            Style="{StaticResource Action.Toggle.Icon}"
            ToolTip="{loc:Tr install.console.show.tip}" />
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor ArrowSquareOutBold}"
            Command="{Binding PopOutConsoleCommand}"
            Style="{StaticResource Action.Icon.Small}"
            ToolTip="{loc:Tr install.console.popOut.tip}" />
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor FileTextBold}"
            Command="{Binding OpenLogCommand}"
            Content="{loc:Tr install.log}"
            Style="{StaticResource Action}"
            ToolTip="{loc:Tr install.log.tip}" />
          <Button
            hc:IconElement.Geometry="{icons:Phosphor StopBold}"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr install.cancel}"
            IsEnabled="{Binding Service.IsCancelling, Converter={StaticResource Boolean2BooleanReConverter}}"
            Style="{StaticResource Action.Danger}"
            Visibility="{Binding Service.IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}" />
          <Button
            hc:IconElement.Geometry="{icons:Phosphor DownloadSimpleBold}"
            Command="{Binding StartCommand}"
            Content="{loc:Tr install.start}"
            Style="{StaticResource Action.Primary}"
            Visibility="{Binding Service.IsRunning, Converter={StaticResource Boolean2VisibilityReConverter}}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--
        ===== Etapas =====
        Da altura inteira da coluna, como uma linha do tempo: as etapas se espalham pela altura (UniformGrid) e um traço
        liga o ícone de uma ao da próxima, verde depois que ela termina. Antes o cartão parava no meio e sobrava um
        buraco embaixo dele.
      -->
      <Border Style="{StaticResource SurfaceCard}">
        <DockPanel>
          <TextBlock
            Margin="0,0,0,10"
            DockPanel.Dock="Top"
            Style="{StaticResource StatLabel}"
            Text="{loc:Tr install.stages}" />
          <ItemsControl ItemsSource="{Binding Service.Stages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type install:StageRow}">
                <DockPanel Background="Transparent" ToolTip="{Binding Description}">
                  <Grid
                    Width="18"
                    Margin="0,1,10,0"
                    DockPanel.Dock="Left">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="18" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Path Style="{StaticResource StageIcon}" />
                    <hc:CircleProgressBar
                      Width="16"
                      Height="16"
                      IsIndeterminate="True"
                      Style="{StaticResource BusyCircle}"
                      Visibility="{Binding IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <Border Grid.Row="1" Style="{StaticResource StageConnector}" />
                  </Grid>
                  <StackPanel>
                    <TextBlock Style="{StaticResource StageTitle}" Text="{Binding Title}" />
                    <TextBlock
                      Margin="0,1,0,0"
                      Style="{StaticResource CaptionText}"
                      Text="{Binding Detail}"
                      TextTrimming="CharacterEllipsis"
                      Visibility="{Binding Detail, Converter={StaticResource String2VisibilityConverter}}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!--  ===== O total, as falhas e o que está trabalhando agora =====  -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Style="{StaticResource SurfaceCard}">
          <StackPanel>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel Margin="24,0,0,0">
                  <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Service.Downloading}" />
                  <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr install.downloading}" />
                </StackPanel>
                <StackPanel Margin="24,0,0,0">
                  <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Service.Extracting}" />
                  <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr install.extracting}" />
                </StackPanel>
                <StackPanel MinWidth="90" Margin="24,0,0,0">
                  <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Service.SpeedText}" />
                  <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr install.speed}" />
                </StackPanel>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource BigNumber}">
                  <Run Text="{Binding Service.Done, Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text=" / " /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Service.Total, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr install.addonsDone}" />
              </StackPanel>
            </DockPanel>
            <ProgressBar
              Height="6"
              Margin="0,14,0,0"
              Maximum="1"
              Value="{Binding Service.Overall, Mode=OneWay}" />
          </StackPanel>
        </Border>

        <!--  Falhas: cada uma com o motivo; "Tentar de novo" repete só elas, sem baixar a lista e os repositórios de novo  -->
        <Border
          Margin="0,16,0,0"
          DockPanel.Dock="Top"
          Style="{StaticResource SurfaceCard}"
          Visibility="{Binding HasFailures, Converter={StaticResource Boolean2VisibilityConverter}}">
          <DockPanel>
            <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
              <Button
                hc:IconElement.Geometry="{icons:Phosphor ArrowClockwiseBold}"
                Command="{Binding RetryCommand}"
                Content="{loc:Tr install.retryFailed}"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Small}" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource DangerBrush}"
                Style="{StaticResource StatLabel}"
                Text="{Binding Service.Failures.Count, StringFormat={loc:Tr install.failures}}" />
            </DockPanel>
            <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Service.Failures}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type install:ModRow}">
                    <DockPanel Margin="0,3">
                      <TextBlock
                        Width="40"
                        DockPanel.Dock="Left"
                        FontFamily="{StaticResource FontFamily.Numbers}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="{Binding Index, StringFormat=#{0}}" />
                      <TextBlock
                        Width="230"
                        DockPanel.Dock="Left"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                      <StackPanel>
                        <TextBlock
                          Foreground="{DynamicResource DangerBrush}"
                          Text="{Binding Detail}"
                          TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding Detail}" />
                        <!--  O que fazer, quando o erro é conhecido: a lâmpada colorida e o texto na cor de legenda  -->
                        <DockPanel Margin="0,2,0,0" Visibility="{Binding Hint, Converter={StaticResource String2VisibilityConverter}}">
                          <Path
                            Width="12"
                            Height="12"
                            Margin="0,2,6,0"
                            VerticalAlignment="Top"
                            Data="{icons:Phosphor LightbulbFill}"
                            DockPanel.Dock="Left"
                            Fill="{DynamicResource WarningBrush}"
                            Stretch="Uniform" />
                          <TextBlock
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{Binding Hint}"
                            TextWrapping="Wrap" />
                        </DockPanel>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Margin="0,16,0,0" Style="{StaticResource SurfaceCard}">
          <DockPanel>
            <!--  Parado: a checagem antes de instalar, com o conserto num botão  -->
            <DockPanel
              Margin="0,0,0,8"
              DockPanel.Dock="Top"
              Visibility="{Binding Service.IsRunning, Converter={StaticResource Boolean2VisibilityReConverter}}">
              <Button
                hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}"
                Command="{Binding CheckAgainCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="{loc:Tr install.checkAgain}" />
              <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource StatLabel}"
                Text="{loc:Tr install.beforeInstall}" />
            </DockPanel>
            <ScrollViewer
              DockPanel.Dock="Top"
              VerticalScrollBarVisibility="Auto"
              Visibility="{Binding Service.IsRunning, Converter={StaticResource Boolean2VisibilityReConverter}}">
              <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type install:PreflightRow}">
                    <DockPanel Margin="0,0,0,7">
                      <Ellipse
                        Width="8"
                        Height="8"
                        Margin="2,6,12,0"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ToneDot}" />
                      <Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Content="{Binding FixText}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Action.Small}"
                        Visibility="{Binding HasFix, Converter={StaticResource Boolean2VisibilityConverter}}" />
                      <StackPanel>
                        <TextBlock
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          Text="{Binding Title}" />
                        <TextBlock
                          Style="{StaticResource CaptionText}"
                          Text="{Binding Message}"
                          TextTrimming="None"
                          TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock
              Margin="0,0,0,8"
              DockPanel.Dock="Top"
              Style="{StaticResource StatLabel}"
              Text="{loc:Tr install.now}"
              Visibility="{Binding Service.IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Grid Visibility="{Binding Service.IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Service.Active}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type install:ModRow}">
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="132" />
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            TextTrimming="CharacterEllipsis">
                            <Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Index, StringFormat=#{0}, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock
                            Style="{StaticResource CaptionText}"
                            Text="{Binding Detail}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Detail}"
                            Visibility="{Binding Detail, Converter={StaticResource String2VisibilityConverter}}" />
                        </StackPanel>
                        <Border
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Left"
                          Style="{StaticResource TonePill}">
                          <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <!--  A barra sempre no meio da linha (na altura da pílula); o "12 de 40 MB" embaixo dela  -->
                        <Grid Grid.Column="2">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <ProgressBar
                            Grid.Row="1"
                            Height="6"
                            IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                            Value="{Binding Percent, Mode=OneWay}" />
                          <TextBlock
                            Grid.Row="2"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontFamily="{StaticResource FontFamily.Numbers}"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding ProgressText}"
                            Visibility="{Binding ProgressText, Converter={StaticResource String2VisibilityConverter}}" />
                        </Grid>
                        <TextBlock
                          Grid.Column="3"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource FontFamily.Numbers}"
                          Foreground="{DynamicResource SecondaryTextBrush}"
                          Text="{Binding SpeedText}"
                          TextAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <controls:EmptyState
                Icon="{icons:Phosphor CompassBold}"
                Text="{Binding Service.Headline}"
                Visibility="{Binding Service.Active.Count, Converter={StaticResource WhenEmpty}}" />
            </Grid>
          </DockPanel>
        </Border>
      </DockPanel>

      <!--  O console das ferramentas: faixa da largura inteira embaixo das duas colunas (liga e desliga no cabeçalho)  -->
      <Border
        Grid.Row="1"
        Grid.ColumnSpan="3"
        Height="190"
        Margin="0,16,0,0"
        Style="{StaticResource SurfaceCard}"
        Visibility="{Binding ShowConsole, Converter={StaticResource Boolean2VisibilityConverter}}">
        <DockPanel>
          <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
            <Button
              hc:IconElement.Geometry="{icons:Phosphor TrashBold}"
              Command="{Binding ClearConsoleCommand}"
              DockPanel.Dock="Right"
              Style="{StaticResource Action.Icon.Small}"
              ToolTip="{loc:Tr shared.clear}" />
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource StatLabel}"
              Text="{loc:Tr install.console.title}" />
            <TextBlock
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource CaptionText}"
              Text="{loc:Tr install.console.caption}" />
          </DockPanel>
          <install:ConsolePanel Lines="{Binding Console.Lines}" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
