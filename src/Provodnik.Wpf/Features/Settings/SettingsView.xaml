<UserControl
  x:Class="Provodnik.Wpf.Features.Settings.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:Provodnik.Wpf.Shared.Behaviors"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:loc="clr-namespace:Provodnik.Wpf.Shared.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:settings="clr-namespace:Provodnik.Wpf.Features.Settings"
  Width="560"
  d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
  Background="Transparent"
  mc:Ignorable="d">

  <!--
    Configurações no jeito da Связь: um cartão por seção com as opções dentro, separadas pela divisória fina; cada uma
    com o título e o que ela faz à esquerda e o controle à direita (chave no lugar da caixinha, número com a
    explicação do lado). Se não couber na janela, o meio rola e a ponta cortada some no degradê.
  -->
  <UserControl.Resources>
    <Style x:Key="Count" TargetType="controls:Stepper">
      <Setter Property="Width" Value="96" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Minimum" Value="1" />
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style
      x:Key="RowSwitch"
      BasedOn="{StaticResource Switch}"
      TargetType="ToggleButton">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
  </UserControl.Resources>

  <!--  O corpo vai até a borda da direita: a barra de rolagem corre no canto do diálogo, longe dos cartões  -->
  <controls:DialogFrame
    BodyPadding="20,0,4,0"
    CloseClick="Done_Click"
    Subtitle="{loc:Tr settings.subtitle}"
    Title="{loc:Tr settings.title}">
    <Grid>
      <ScrollViewer
        MaxHeight="460"
        behaviors:ScrollFade.Cover="{Binding ElementName=BottomFade}"
        behaviors:ScrollFade.IsEnabled="True"
        behaviors:ScrollFade.TopCover="{Binding ElementName=TopFade}"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,2,16,18">
          <TextBlock Style="{StaticResource SettingSection}" Text="{loc:Tr settings.section.folder}" />
          <Border Style="{StaticResource SettingGroup}">
            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <DockPanel>
                  <Button
                    Margin="6,0,0,0"
                    hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                    Command="{Binding BrowseCommand}"
                    DockPanel.Dock="Right"
                    IsEnabled="{Binding IsPortable, Converter={StaticResource Boolean2BooleanReConverter}}"
                    Style="{StaticResource Action.Icon}"
                    ToolTip="{loc:Tr settings.folder.browse}" />
                  <hc:TextBox
                    hc:InfoElement.Placeholder="D:\GAMMA"
                    IsReadOnly="{Binding IsPortable}"
                    Style="{StaticResource FieldBox}"
                    Text="{Binding GammaRoot}" />
                </DockPanel>
                <TextBlock
                  Style="{StaticResource SettingCaption}"
                  Text="{loc:Tr settings.folder.fixed}"
                  Visibility="{Binding IsPortable, Converter={StaticResource Boolean2VisibilityConverter}}" />
                <TextBlock
                  Margin="0,4,0,0"
                  Foreground="{DynamicResource DangerBrush}"
                  Text="{Binding Error}"
                  TextWrapping="Wrap"
                  Visibility="{Binding Error, Converter={StaticResource String2VisibilityConverter}}" />
              </StackPanel>
            </Border>
          </Border>

          <TextBlock Style="{StaticResource SettingSection}" Text="{loc:Tr settings.section.parallel}" />
          <Border Style="{StaticResource SettingGroup}">
            <StackPanel>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <controls:Stepper
                    Maximum="8"
                    Style="{StaticResource Count}"
                    Value="{Binding ModDbParallel}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.moddb.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.moddb.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <controls:Stepper
                    Maximum="16"
                    Style="{StaticResource Count}"
                    Value="{Binding HttpParallel}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.github.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.github.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <controls:Stepper
                    Maximum="8"
                    Style="{StaticResource Count}"
                    Value="{Binding ExtractParallel}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.extract.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.extract.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SettingSection}" Text="{loc:Tr settings.section.install}" />
          <Border Style="{StaticResource SettingGroup}">
            <StackPanel>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding CheckMd5}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.md5.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.md5.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding UpdateGitHubAddons}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.githubAddons.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.githubAddons.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding DeleteReshadeDlls}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.reshade.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.reshade.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding CreateShortcuts}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.shortcuts.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.shortcuts.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding BackupSaves}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.backupSaves.title}" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.backupSaves.caption}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SettingSection}" Text="{loc:Tr settings.section.app}" />
          <Border Style="{StaticResource SettingGroup}">
            <StackPanel>
            <Border Style="{StaticResource SettingRow}">
              <DockPanel>
                <controls:SelectField
                  Width="150"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  DockPanel.Dock="Right"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding Language}" />
                <StackPanel>
                  <TextBlock Style="{StaticResource SettingTitle}" Text="Idioma · Language · Язык" />
                  <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.languageRow.caption}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Style="{StaticResource InfoDivider}" />
            <Border Style="{StaticResource SettingRow}">
              <DockPanel>
                <ToggleButton IsChecked="{Binding AutoUpdateApp}" Style="{StaticResource RowSwitch}" />
                <StackPanel>
                  <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.autoUpdate.title}" />
                  <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.autoUpdate.caption}" />
                </StackPanel>
              </DockPanel>
            </Border>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SettingSection}" Text="{loc:Tr settings.section.appearance}" />
          <Border Style="{StaticResource SettingGroup}">
            <Border Style="{StaticResource SettingRow}">
              <DockPanel>
                <ToggleButton IsChecked="{Binding Mica}" Style="{StaticResource RowSwitch}" />
                <StackPanel>
                  <TextBlock Style="{StaticResource SettingTitle}" Text="{loc:Tr settings.mica.title}" />
                  <TextBlock Style="{StaticResource SettingCaption}" Text="{loc:Tr settings.mica.caption}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Border>
        </StackPanel>
      </ScrollViewer>
        <!--  As pontas cortadas somem no fundo do diálogo (a máscara do ScrollFade serrilhava os cantos aqui dentro)  -->
      <Border
        x:Name="TopFade"
        Height="20"
        Margin="0,0,16,0"
        VerticalAlignment="Top"
        Background="{DynamicResource RegionBrush}"
        IsHitTestVisible="False">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="Black" />
            <GradientStop Offset="1" Color="Transparent" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
      <Border
        x:Name="BottomFade"
        Height="28"
        Margin="0,0,16,0"
        VerticalAlignment="Bottom"
        Background="{DynamicResource RegionBrush}"
        IsHitTestVisible="False">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="1" Color="Black" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
    </Grid>

    <controls:DialogFrame.Footer>
      <hc:UniformSpacingPanel Style="{StaticResource DialogActions}">
        <Button
          Click="Done_Click"
          Content="{loc:Tr settings.done}"
          IsCancel="True"
          IsDefault="True"
          Style="{StaticResource Action.Dialog.Primary}" />
      </hc:UniformSpacingPanel>
    </controls:DialogFrame.Footer>
  </controls:DialogFrame>
</UserControl>
