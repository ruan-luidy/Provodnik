<UserControl
  x:Class="Provodnik.Wpf.Features.Settings.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="clr-namespace:Provodnik.Wpf.Shared.Behaviors"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:settings="clr-namespace:Provodnik.Wpf.Features.Settings"
  Width="560"
  d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
  Background="Transparent"
  mc:Ignorable="d">

  <!--
    Configurações no jeito da Связь: um cartão por seção com as opções dentro, separadas pela divisória fina; cada uma
    com o título e o que ela faz à esquerda e o controle à direita (chave no lugar da caixinha, número com a
    explicação do lado). Se não couber na janela, o meio rola e a ponta cortada some no degradê.
  -->
  <UserControl.Resources>
    <Style x:Key="Count" TargetType="controls:Stepper">
      <Setter Property="Width" Value="96" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Minimum" Value="1" />
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style
      x:Key="RowSwitch"
      BasedOn="{StaticResource Switch}"
      TargetType="ToggleButton">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
  </UserControl.Resources>

  <!--  O corpo vai até a borda da direita: a barra de rolagem corre no canto do diálogo, longe dos cartões  -->
  <controls:DialogFrame
    BodyPadding="20,0,4,0"
    CloseClick="Cancel_Click"
    Subtitle="Valem pra próxima instalação"
    Title="Configurações">
    <Grid>
      <ScrollViewer
        MaxHeight="460"
        behaviors:ScrollFade.Cover="{Binding ElementName=BottomFade}"
        behaviors:ScrollFade.IsEnabled="True"
        behaviors:ScrollFade.TopCover="{Binding ElementName=TopFade}"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,2,16,18">
          <TextBlock Style="{StaticResource SettingSection}" Text="PASTA DO GAMMA" />
          <Border Style="{StaticResource SettingGroup}">
            <Border Style="{StaticResource SettingRow}">
              <StackPanel>
                <DockPanel>
                  <Button
                    Margin="6,0,0,0"
                    hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                    Command="{Binding BrowseCommand}"
                    DockPanel.Dock="Right"
                    IsEnabled="{Binding IsPortable, Converter={StaticResource Boolean2BooleanReConverter}}"
                    Style="{StaticResource Action.Icon}"
                    ToolTip="Escolher a pasta" />
                  <hc:TextBox
                    hc:InfoElement.Placeholder="D:\GAMMA"
                    IsReadOnly="{Binding IsPortable}"
                    Style="{StaticResource FieldBox}"
                    Text="{Binding GammaRoot}" />
                </DockPanel>
                <TextBlock
                  Style="{StaticResource SettingCaption}"
                  Text="O Проводник está dentro dessa pasta, então ela é fixa."
                  Visibility="{Binding IsPortable, Converter={StaticResource Boolean2VisibilityConverter}}" />
                <TextBlock
                  Margin="0,4,0,0"
                  Foreground="{DynamicResource DangerBrush}"
                  Text="{Binding Error}"
                  TextWrapping="Wrap"
                  Visibility="{Binding Error, Converter={StaticResource String2VisibilityConverter}}" />
              </StackPanel>
            </Border>
          </Border>

          <TextBlock Style="{StaticResource SettingSection}" Text="AO MESMO TEMPO" />
          <Border Style="{StaticResource SettingGroup}">
            <StackPanel>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <controls:Stepper
                    Maximum="8"
                    Style="{StaticResource Count}"
                    Value="{Binding ModDbParallel}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Downloads do ModDB" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="Os links saem um por vez, no ritmo que o ModDB aceita; a fila esfria sozinha quando ele reclama." />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <controls:Stepper
                    Maximum="16"
                    Style="{StaticResource Count}"
                    Value="{Binding HttpParallel}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Downloads do GitHub" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="Os addons que vêm direto do GitHub e do gofile." />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <controls:Stepper
                    Maximum="8"
                    Style="{StaticResource Count}"
                    Value="{Binding ExtractParallel}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Extrações" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="O gargalo é o disco: em HD, deixe 1." />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SettingSection}" Text="INSTALAÇÃO" />
          <Border Style="{StaticResource SettingGroup}">
            <StackPanel>
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding CheckMd5}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Conferir o md5 dos arquivos" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="Arquivo que não bate com a lista é baixado de novo. Desligar é inseguro." />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding UpdateGitHubAddons}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Atualizar os addons do GitHub" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="Pergunta pro GitHub se o zip mudou e baixa só quando mudou." />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding DeleteReshadeDlls}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Apagar as DLLs do Reshade" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="dxgi.dll e d3d9.dll em Anomaly\bin, como o launcher original faz." />
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource InfoDivider}" />
              <Border Style="{StaticResource SettingRow}">
                <DockPanel>
                  <ToggleButton IsChecked="{Binding CreateShortcuts}" Style="{StaticResource RowSwitch}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Criar atalhos na área de trabalho" />
                    <TextBlock Style="{StaticResource SettingCaption}" Text="Pro Проводник e pro MO2 do GAMMA." />
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SettingSection}" Text="APARÊNCIA" />
          <Border Style="{StaticResource SettingGroup}">
            <Border Style="{StaticResource SettingRow}">
              <DockPanel>
                <ToggleButton IsChecked="{Binding Mica}" Style="{StaticResource RowSwitch}" />
                <StackPanel>
                  <TextBlock Style="{StaticResource SettingTitle}" Text="Fundo Mica" />
                  <TextBlock Style="{StaticResource SettingCaption}" Text="O fundo translúcido do Windows 11. No Windows 10 fica o cinza sólido." />
                </StackPanel>
              </DockPanel>
            </Border>
          </Border>
        </StackPanel>
      </ScrollViewer>
        <!--  As pontas cortadas somem no fundo do diálogo (a máscara do ScrollFade serrilhava os cantos aqui dentro)  -->
      <Border
        x:Name="TopFade"
        Height="20"
        Margin="0,0,16,0"
        VerticalAlignment="Top"
        Background="{DynamicResource RegionBrush}"
        IsHitTestVisible="False">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="Black" />
            <GradientStop Offset="1" Color="Transparent" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
      <Border
        x:Name="BottomFade"
        Height="28"
        Margin="0,0,16,0"
        VerticalAlignment="Bottom"
        Background="{DynamicResource RegionBrush}"
        IsHitTestVisible="False">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="1" Color="Black" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
    </Grid>

    <controls:DialogFrame.Footer>
      <hc:UniformSpacingPanel Style="{StaticResource DialogActions}">
        <Button
          Click="Cancel_Click"
          Content="Cancelar"
          IsCancel="True"
          Style="{StaticResource Action.Dialog}" />
        <Button
          Click="Save_Click"
          Content="Salvar"
          IsDefault="True"
          Style="{StaticResource Action.Dialog.Primary}" />
      </hc:UniformSpacingPanel>
    </controls:DialogFrame.Footer>
  </controls:DialogFrame>
</UserControl>
