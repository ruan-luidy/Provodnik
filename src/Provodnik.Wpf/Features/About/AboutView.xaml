<UserControl
  x:Class="Provodnik.Wpf.Features.About.AboutView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:about="clr-namespace:Provodnik.Wpf.Features.About"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:loc="clr-namespace:Provodnik.Wpf.Shared.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Width="520"
  d:DataContext="{d:DesignInstance Type=about:AboutViewModel}"
  Background="Transparent"
  mc:Ignorable="d">

  <!--
    Sobre: o selo do app com a versão, a procura de versão nova (baixa do GitHub e troca o exe ao reiniciar) e os
    links. Os grupos são os cartões das Configurações.
  -->
  <controls:DialogFrame
    BodyPadding="20,0,20,16"
    CloseClick="Close_Click"
    Subtitle="{loc:Tr about.subtitle}"
    Title="{loc:Tr about.title}">
    <StackPanel>
      <!--  O selo: o ícone grande, o nome e a versão  -->
      <DockPanel Margin="0,16,0,2">
        <Border
          Width="56"
          Height="56"
          Margin="0,0,14,0"
          Background="{DynamicResource Card.BackgroundBrush}"
          CornerRadius="14"
          DockPanel.Dock="Left">
          <Image
            Width="40"
            Height="40"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="/Assets/provodnik.png" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock
            FontSize="{StaticResource FontSize.Lg}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryTextBrush}"
            Text="{loc:Tr shell.appName}" />
          <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}">
            <Run FontFamily="{StaticResource FontFamily.Numbers}" Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding BuildText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </DockPanel>

      <TextBlock Style="{StaticResource SettingSection}" Text="{loc:Tr about.update.section}" />
      <Border Style="{StaticResource SettingGroup}">
        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              DockPanel.Dock="Right"
              Orientation="Horizontal">
              <Button
                hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}"
                Command="{Binding Update.CheckNowCommand}"
                Content="{loc:Tr about.update.check}"
                Style="{StaticResource Action}"
                ToolTip="{loc:Tr about.update.checkTip}" />
              <!--  A versão nova já baixou do lado do exe: é só reiniciar pra trocar  -->
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor ArrowCircleUpBold}"
                Command="{Binding Update.ApplyAndRestartCommand}"
                Content="{loc:Tr about.update.restart}"
                Style="{StaticResource Action.Primary}"
                Visibility="{Binding Update.IsReady, Converter={StaticResource Boolean2VisibilityConverter}}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Update.Status}" />
              <ProgressBar
                Height="4"
                Margin="0,6,0,0"
                Maximum="100"
                Value="{Binding Update.Progress, Mode=OneWay}">
                <ProgressBar.Style>
                  <Style BasedOn="{StaticResource SlimProgress}" TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Update.State}" Value="Downloading">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
            </StackPanel>
          </DockPanel>
        </Border>
      </Border>

      <TextBlock Style="{StaticResource SettingSection}" Text="{loc:Tr about.links.section}" />
      <StackPanel Orientation="Horizontal">
        <Button
          Margin="0,0,8,0"
          hc:IconElement.Geometry="{icons:Phosphor GithubLogoBold}"
          Command="{Binding OpenRepositoryCommand}"
          Content="{loc:Tr about.links.code}"
          Style="{StaticResource Action}" />
        <Button
          Margin="0,0,8,0"
          hc:IconElement.Geometry="{icons:Phosphor PackageBold}"
          Command="{Binding OpenReleasesCommand}"
          Content="{loc:Tr about.links.releases}"
          Style="{StaticResource Action}" />
        <Button
          hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
          Command="{Binding OpenDataFolderCommand}"
          Content="{loc:Tr about.links.data}"
          Style="{StaticResource Action}"
          ToolTip="{loc:Tr about.links.dataTip}" />
      </StackPanel>

      <TextBlock
        Margin="2,16,0,0"
        Style="{StaticResource CaptionText}"
        Text="{loc:Tr about.disclaimer}"
        TextTrimming="None"
        TextWrapping="Wrap" />
      <TextBlock
        Margin="2,4,0,0"
        Style="{StaticResource CaptionText}"
        Text="{loc:Tr about.iconCredit}" />
    </StackPanel>

    <controls:DialogFrame.Footer>
      <hc:UniformSpacingPanel Style="{StaticResource DialogActions}">
        <Button
          Click="Close_Click"
          Content="{loc:Tr about.close}"
          IsCancel="True"
          IsDefault="True"
          Style="{StaticResource Action.Dialog}" />
      </hc:UniformSpacingPanel>
    </controls:DialogFrame.Footer>
  </controls:DialogFrame>
</UserControl>
