<UserControl
  x:Class="Provodnik.Wpf.Features.About.AboutView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:about="clr-namespace:Provodnik.Wpf.Features.About"
  xmlns:behaviors="clr-namespace:Provodnik.Wpf.Shared.Behaviors"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Width="520"
  d:DataContext="{d:DesignInstance Type=about:AboutViewModel}"
  Background="Transparent"
  mc:Ignorable="d">

  <!--
    Sobre: o selo do app com a versão, a atualização do próprio Проводник (procurar, ou reiniciar com a versão que
    já baixou; o exe solto na pasta do GAMMA aponta pros Releases), o que mudou nesta versão e os links. Os grupos são
    os cartões das Configurações.
  -->
  <controls:DialogFrame
    BodyPadding="20,0,20,16"
    CloseClick="Close_Click"
    Subtitle="O launcher do S.T.A.L.K.E.R. G.A.M.M.A."
    Title="Sobre o Проводник">
    <StackPanel>
      <!--  O selo: o ícone grande, o nome e a versão  -->
      <DockPanel Margin="0,16,0,2">
        <Border
          Width="56"
          Height="56"
          Margin="0,0,14,0"
          Background="{DynamicResource Card.BackgroundBrush}"
          CornerRadius="14"
          DockPanel.Dock="Left">
          <Image
            Width="40"
            Height="40"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="/Assets/provodnik.png" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock
            FontSize="{StaticResource FontSize.Lg}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryTextBrush}"
            Text="Проводник" />
          <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}">
            <Run FontFamily="{StaticResource FontFamily.Numbers}" Text="{Binding Version, Mode=OneWay, StringFormat=versão {0}}" /><Run Text=" · " /><Run Text="{Binding BuildText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
      </DockPanel>

      <TextBlock Style="{StaticResource SettingSection}" Text="ATUALIZAÇÃO" />
      <Border Style="{StaticResource SettingGroup}">
        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              DockPanel.Dock="Right"
              Orientation="Horizontal">
              <!--  Instalado pelo Setup.exe: procurar agora, ou reiniciar com a versão que já baixou  -->
              <Button
                hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}"
                Command="{Binding Update.CheckNowCommand}"
                Content="Procurar"
                Style="{StaticResource Action}"
                Visibility="{Binding Update.CanUpdate, Converter={StaticResource Boolean2VisibilityConverter}}" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor ArrowCircleUpBold}"
                Command="{Binding Update.ApplyAndRestartCommand}"
                Content="Reiniciar e atualizar"
                Style="{StaticResource Action.Primary}"
                Visibility="{Binding Update.IsReady, Converter={StaticResource Boolean2VisibilityConverter}}" />
              <!--  O exe solto na pasta do GAMMA: a versão nova se baixa nos Releases  -->
              <Button
                hc:IconElement.Geometry="{icons:Phosphor ArrowSquareOutBold}"
                Command="{Binding OpenReleasesCommand}"
                Content="Releases"
                Style="{StaticResource Action}"
                Visibility="{Binding IsPortable, Converter={StaticResource Boolean2VisibilityConverter}}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SettingTitle}" Text="{Binding Update.Status}" />
              <TextBlock
                Style="{StaticResource SettingCaption}"
                Text="Esta cópia não se atualiza sozinha: a versão nova sai nos Releases do GitHub."
                Visibility="{Binding IsPortable, Converter={StaticResource Boolean2VisibilityConverter}}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Border>

      <TextBlock
        Style="{StaticResource SettingSection}"
        Text="{Binding Version, StringFormat=O QUE MUDOU NA {0}}"
        Visibility="{Binding Changes.Count, Converter={StaticResource WhenAny}}" />
      <Border
        Padding="14,0"
        Style="{StaticResource SettingGroup}"
        Visibility="{Binding Changes.Count, Converter={StaticResource WhenAny}}">
        <Grid>
          <ScrollViewer
            MaxHeight="170"
            Margin="0,0,-10,0"
            behaviors:ScrollFade.Cover="{Binding ElementName=ChangesFade}"
            behaviors:ScrollFade.IsEnabled="True"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,10,10,10" ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,6">
                    <Ellipse
                      Width="4"
                      Height="4"
                      Margin="0,7,9,0"
                      VerticalAlignment="Top"
                      DockPanel.Dock="Left"
                      Fill="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock
                      FontSize="{StaticResource FontSize.Sm}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      Text="{Binding}"
                      TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <!--  A ponta cortada some no fundo do cartão  -->
          <!--  As duas camadas do fundo (o diálogo e o branco fraco do cartão), pra cor casar com a do cartão  -->
          <Grid
            x:Name="ChangesFade"
            Height="24"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False">
            <Grid.OpacityMask>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="Transparent" />
                <GradientStop Offset="1" Color="Black" />
              </LinearGradientBrush>
            </Grid.OpacityMask>
            <Border Background="{DynamicResource RegionBrush}" />
            <Border Background="{DynamicResource Card.BackgroundBrush}" />
          </Grid>
        </Grid>
      </Border>

      <TextBlock Style="{StaticResource SettingSection}" Text="LINKS" />
      <StackPanel Orientation="Horizontal">
        <Button
          Margin="0,0,8,0"
          hc:IconElement.Geometry="{icons:Phosphor GithubLogoBold}"
          Command="{Binding OpenRepositoryCommand}"
          Content="Código no GitHub"
          Style="{StaticResource Action}" />
        <Button
          Margin="0,0,8,0"
          hc:IconElement.Geometry="{icons:Phosphor PackageBold}"
          Command="{Binding OpenReleasesCommand}"
          Content="Releases"
          Style="{StaticResource Action}" />
        <Button
          hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
          Command="{Binding OpenDataFolderCommand}"
          Content="Pasta de dados"
          Style="{StaticResource Action}"
          ToolTip="Logs, estado da instalação e cache (.provodnik dentro do instalador do GAMMA)" />
      </StackPanel>

      <TextBlock
        Margin="2,16,0,0"
        Style="{StaticResource CaptionText}"
        Text="Feito por fã, não é oficial do G.A.M.M.A. O modpack, a lista de mods e o launcher original são do Grok e da equipe do GAMMA."
        TextTrimming="None"
        TextWrapping="Wrap" />
    </StackPanel>

    <controls:DialogFrame.Footer>
      <hc:UniformSpacingPanel Style="{StaticResource DialogActions}">
        <Button
          Click="Close_Click"
          Content="Fechar"
          IsCancel="True"
          IsDefault="True"
          Style="{StaticResource Action.Dialog}" />
      </hc:UniformSpacingPanel>
    </controls:DialogFrame.Footer>
  </controls:DialogFrame>
</UserControl>
