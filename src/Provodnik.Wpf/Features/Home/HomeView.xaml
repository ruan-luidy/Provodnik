<UserControl
  x:Class="Provodnik.Wpf.Features.Home.HomeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:home="clr-namespace:Provodnik.Wpf.Features.Home"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:loc="clr-namespace:Provodnik.Wpf.Shared.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:shared="clr-namespace:Provodnik.Wpf.Shared"
  d:DataContext="{d:DesignInstance Type=home:HomeViewModel}"
  mc:Ignorable="d">

  <UserControl.Resources>
    <!--  Linha "rótulo ..... caminho [abrir]" do cartão de pastas  -->
    <Style x:Key="PathLabel" TargetType="TextBlock">
      <Setter Property="Width" Value="90" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="PathValue" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <!--  O quadradinho do ícone dos números: azul suave, ícone azul  -->
    <Style x:Key="StatIconBox" TargetType="Border">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
    </Style>
    <Style x:Key="StatIcon" TargetType="Path">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!--  O cartão do estado: o degradê suave da cor do estado vindo da esquerda por cima do cartão translúcido  -->
    <Style x:Key="HeroCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}" />
      <Setter Property="Background" Value="{DynamicResource Card.BackgroundBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Success}">
          <Setter Property="Background">
            <Setter.Value>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#2E33C467" />
                <GradientStop Offset="0.55" Color="#14FFFFFF" />
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Warning}">
          <Setter Property="Background">
            <Setter.Value>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#2EF0B429" />
                <GradientStop Offset="0.55" Color="#14FFFFFF" />
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Error}">
          <Setter Property="Background">
            <Setter.Value>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#2EF05A66" />
                <GradientStop Offset="0.55" Color="#14FFFFFF" />
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HeroIconBox" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource Accent.SoftBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Success}">
          <Setter Property="Background" Value="{DynamicResource Success.SoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Warning}">
          <Setter Property="Background" Value="{DynamicResource Warning.SoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Error}">
          <Setter Property="Background" Value="{DynamicResource Danger.SoftBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HeroIcon" TargetType="Path">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Data" Value="{icons:Phosphor InfoFill}" />
      <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Success}">
          <Setter Property="Data" Value="{icons:Phosphor CheckCircleFill}" />
          <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Warning}">
          <Setter Property="Data" Value="{icons:Phosphor WarningCircleFill}" />
          <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static shared:RowTone.Error}">
          <Setter Property="Data" Value="{icons:Phosphor XCircleFill}" />
          <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="S.T.A.L.K.E.R. G.A.M.M.A." Subtitle="{Binding GammaRoot}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Visibility="{Binding HasGamma, Converter={StaticResource Boolean2VisibilityConverter}}">
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}"
            Command="{Binding CheckCommand}"
            Content="{loc:Tr home.check}"
            Style="{StaticResource Action}"
            ToolTip="{loc:Tr home.check.tip}" />
          <Button
            hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
            Command="{Binding OpenFolderCommand}"
            Content="{loc:Tr home.openGammaFolder}"
            Style="{StaticResource Action}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <!--  ===== Sem GAMMA: escolher a pasta =====  -->
    <Border
      Grid.Row="1"
      MaxWidth="560"
      VerticalAlignment="Center"
      Style="{StaticResource SurfaceCard}"
      Visibility="{Binding HasGamma, Converter={StaticResource Boolean2VisibilityReConverter}}">
      <StackPanel Margin="12">
        <Path
          Width="36"
          Height="36"
          Data="{icons:Phosphor CompassBold}"
          Fill="{DynamicResource PrimaryBrush}"
          Stretch="Uniform" />
        <TextBlock
          Margin="0,12,0,0"
          HorizontalAlignment="Center"
          FontSize="{StaticResource FontSize.Lg}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource PrimaryTextBrush}"
          Text="{loc:Tr home.noGamma.title}" />
        <TextBlock
          Margin="0,6,0,0"
          Style="{StaticResource CaptionText}"
          Text="{loc:Tr home.noGamma.text}"
          TextAlignment="Center"
          TextTrimming="None"
          TextWrapping="Wrap" />
        <Button
          Margin="0,16,0,0"
          HorizontalAlignment="Center"
          hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
          Command="{Binding ChooseFolderCommand}"
          Content="{loc:Tr home.noGamma.choose}"
          Style="{StaticResource Action.Primary}" />
      </StackPanel>
    </Border>

    <!--  ===== Com GAMMA =====  -->
    <ScrollViewer
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      Visibility="{Binding HasGamma, Converter={StaticResource Boolean2VisibilityConverter}}">
      <StackPanel>
        <!--
          O cartão do estado: o ícone grande no quadrado da cor do estado, e um degradê bem suave dessa cor vindo da
          esquerda (verde em dia, amarelo atenção, vermelho problema). Jogar e Instalar à direita.
        -->
        <Border Padding="18,16" Style="{StaticResource HeroCard}">
          <DockPanel>
            <StackPanel
              VerticalAlignment="Center"
              DockPanel.Dock="Right"
              Orientation="Horizontal">
              <controls:SelectField
                Width="190"
                Margin="0,0,8,0"
                ItemsSource="{Binding Executables}"
                Placeholder="{loc:Tr home.executable}"
                SelectedItem="{Binding SelectedExecutable}"
                ToolTip="{loc:Tr home.executable.tip}" />
              <Button
                Margin="0,0,8,0"
                hc:IconElement.Geometry="{icons:Phosphor DownloadSimpleBold}"
                Command="{Binding GoInstallCommand}"
                Content="{loc:Tr home.install}"
                IsEnabled="{Binding Install.IsRunning, Converter={StaticResource Boolean2BooleanReConverter}}"
                Style="{StaticResource Action}" />
              <Button
                Width="120"
                hc:IconElement.Geometry="{icons:Phosphor PlayFill}"
                Command="{Binding PlayCommand}"
                Content="{loc:Tr home.play}"
                Style="{StaticResource Action.Primary}" />
            </StackPanel>

            <Border
              Width="48"
              Height="48"
              Margin="0,0,16,0"
              VerticalAlignment="Center"
              DockPanel.Dock="Left"
              Style="{StaticResource HeroIconBox}">
              <Grid>
                <Path
                  Width="24"
                  Height="24"
                  Style="{StaticResource HeroIcon}"
                  Visibility="{Binding IsChecking, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                <hc:CircleProgressBar
                  Width="22"
                  Height="22"
                  IsIndeterminate="True"
                  Style="{StaticResource BusyCircle}"
                  Visibility="{Binding IsChecking, Converter={StaticResource Boolean2VisibilityConverter}}" />
              </Grid>
            </Border>

            <StackPanel VerticalAlignment="Center">
              <TextBlock
                FontSize="{StaticResource FontSize.Lg}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="{Binding StatusTitle}" />
              <TextBlock
                Margin="0,3,16,0"
                Style="{StaticResource CaptionText}"
                Text="{Binding StatusText}"
                TextTrimming="None"
                TextWrapping="Wrap" />
              <!--  A instalação rodando aparece aqui também, com a barra  -->
              <StackPanel Margin="0,10,16,0" Visibility="{Binding Install.IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}">
                <TextBlock
                  Foreground="{DynamicResource PrimaryBrush}"
                  Text="{Binding Install.Headline}"
                  TextTrimming="CharacterEllipsis" />
                <ProgressBar
                  Height="4"
                  Margin="0,6,0,0"
                  Maximum="1"
                  Value="{Binding Install.Overall, Mode=OneWay}" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!--  Os números: ícone no quadradinho azul, o valor grande e, nas proporções, a barrinha (verde quando completa)  -->
        <UniformGrid
          Margin="0,12,-10,0"
          Columns="5"
          Rows="1">
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource StatIconBox}">
                  <Path Data="{icons:Phosphor GitBranchBold}" Style="{StaticResource StatIcon}" />
                </Border>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource StatLabel}" Text="{loc:Tr home.stat.definition}" />
              </DockPanel>
              <TextBlock Style="{StaticResource StatNumber}" Text="{Binding VersionText}" />
              <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OnlineVersionText, StringFormat={loc:Tr home.stat.online}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource StatIconBox}">
                  <Path Data="{icons:Phosphor PackageBold}" Style="{StaticResource StatIcon}" />
                </Border>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource StatLabel}" Text="{loc:Tr home.stat.addons}" />
              </DockPanel>
              <TextBlock Style="{StaticResource StatNumber}">
                <Run Text="{Binding ModsInstalled, Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ModsTotal, Mode=OneWay, StringFormat=' / {0}'}" />
              </TextBlock>
              <ProgressBar
                Height="3"
                Margin="0,6,0,6"
                Maximum="1"
                Value="{Binding ModsFraction, Mode=OneWay}">
                <ProgressBar.Style>
                  <Style BasedOn="{StaticResource SlimProgress}" TargetType="ProgressBar">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ModsComplete}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
              <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ModListText, StringFormat={loc:Tr home.stat.modList}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource StatIconBox}">
                  <Path Data="{icons:Phosphor ToggleRightBold}" Style="{StaticResource StatIcon}" />
                </Border>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource StatLabel}" Text="{loc:Tr home.stat.active}" />
              </DockPanel>
              <TextBlock Style="{StaticResource StatNumber}">
                <Run Text="{Binding ActiveFound, Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ActiveExpected, Mode=OneWay, StringFormat=' / {0}'}" />
              </TextBlock>
              <ProgressBar
                Height="3"
                Margin="0,6,0,6"
                Maximum="1"
                Value="{Binding ActiveFraction, Mode=OneWay}">
                <ProgressBar.Style>
                  <Style BasedOn="{StaticResource SlimProgress}" TargetType="ProgressBar">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveComplete}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
              <TextBlock
                Style="{StaticResource CaptionText}"
                Text="{loc:Tr home.stat.rule}"
                ToolTip="{loc:Tr home.stat.rule.tip}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource StatIconBox}">
                  <Path Data="{icons:Phosphor CloudArrowDownBold}" Style="{StaticResource StatIcon}" />
                </Border>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource StatLabel}" Text="{loc:Tr home.stat.missing}" />
              </DockPanel>
              <TextBlock Style="{StaticResource StatNumber}" Text="{Binding ArchivesMissing}" />
              <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr home.stat.missing.caption}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource StatIconBox}">
                  <Path Data="{icons:Phosphor ClockCounterClockwiseBold}" Style="{StaticResource StatIcon}" />
                </Border>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource StatLabel}" Text="{loc:Tr home.stat.last}" />
              </DockPanel>
              <TextBlock
                FontFamily="{StaticResource FontFamily.Default}"
                FontSize="{StaticResource FontSize.Lg}"
                Style="{StaticResource StatNumber}"
                Text="{Binding LastInstallText}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr home.stat.last.caption}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!--  Onde está tudo: o cartão de informação da Связь (rótulo, valor à direita, abrir colado nele, divisória fina)  -->
        <TextBlock
          Margin="2,16,0,6"
          Style="{StaticResource StatLabel}"
          Text="{loc:Tr home.folders}" />
        <Border Style="{StaticResource InfoCard}">
          <StackPanel>
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="GAMMA" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="{loc:Tr home.folders.open}" />
              <TextBlock
                FontFamily="{StaticResource FontFamily.Numbers}"
                Style="{StaticResource InfoValue}"
                Text="{Binding GammaRoot}" />
            </DockPanel>
            <Border Style="{StaticResource InfoDivider}" />
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="Anomaly" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                CommandParameter="anomaly"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="{loc:Tr home.folders.open}" />
              <TextBlock
                FontFamily="{StaticResource FontFamily.Numbers}"
                Style="{StaticResource InfoValue}"
                Text="{Binding AnomalyPath}" />
            </DockPanel>
            <Border Style="{StaticResource InfoDivider}" />
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="{loc:Tr home.folders.profile}" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                CommandParameter="profile"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="{loc:Tr home.folders.open}" />
              <TextBlock Style="{StaticResource InfoValue}" Text="{Binding ProfileName}" />
            </DockPanel>
            <Border Style="{StaticResource InfoDivider}" />
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="Mod Organizer" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor SlidersHorizontalBold}"
                Command="{Binding OpenModOrganizerCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="{loc:Tr home.folders.openMo2}" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                CommandParameter="downloads"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="{loc:Tr home.folders.openDownloads}" />
              <TextBlock Style="{StaticResource InfoValue}" Text="{loc:Tr home.folders.mo2}" />
            </DockPanel>
          </StackPanel>
        </Border>
        <!--  Dica de usar dentro da pasta, só quando o exe está fora dela  -->
        <Border
          Margin="0,16,0,0"
          Style="{StaticResource SurfaceCard}"
          Visibility="{Binding IsPortable, Converter={StaticResource Boolean2VisibilityReConverter}}">
          <DockPanel>
            <Path
              Width="18"
              Height="18"
              Margin="0,0,12,0"
              VerticalAlignment="Top"
              Data="{icons:Phosphor LightbulbBold}"
              DockPanel.Dock="Left"
              Fill="{DynamicResource WarningBrush}"
              Stretch="Uniform" />
            <TextBlock
              Foreground="{DynamicResource SecondaryTextBrush}"
              TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{loc:Tr home.tip}" />
              <Run Text="{loc:Tr home.tip.text}" />
            </TextBlock>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
