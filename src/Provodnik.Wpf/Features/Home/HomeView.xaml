<UserControl
  x:Class="Provodnik.Wpf.Features.Home.HomeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:Provodnik.Wpf.Shared.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:hc="https://handyorg.github.io/handycontrol"
  xmlns:home="clr-namespace:Provodnik.Wpf.Features.Home"
  xmlns:icons="clr-namespace:Provodnik.Wpf.Shared.Icons"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DataContext="{d:DesignInstance Type=home:HomeViewModel}"
  mc:Ignorable="d">

  <UserControl.Resources>
    <!--  Linha "rótulo ..... caminho [abrir]" do cartão de pastas  -->
    <Style x:Key="PathLabel" TargetType="TextBlock">
      <Setter Property="Width" Value="90" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="PathValue" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontFamily" Value="{StaticResource FontFamily.Numbers}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Title="S.T.A.L.K.E.R. G.A.M.M.A." Subtitle="{Binding GammaRoot}">
      <controls:PageHeader.Actions>
        <StackPanel Orientation="Horizontal" Visibility="{Binding HasGamma, Converter={StaticResource Boolean2VisibilityConverter}}">
          <Button
            Margin="0,0,8,0"
            hc:IconElement.Geometry="{icons:Phosphor ArrowsClockwiseBold}"
            Command="{Binding CheckCommand}"
            Content="Conferir"
            Style="{StaticResource Action}"
            ToolTip="Pergunta de novo se tem atualização" />
          <Button
            hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
            Command="{Binding OpenFolderCommand}"
            Content="Pasta do GAMMA"
            Style="{StaticResource Action}" />
        </StackPanel>
      </controls:PageHeader.Actions>
    </controls:PageHeader>

    <!--  ===== Sem GAMMA: escolher a pasta =====  -->
    <Border
      Grid.Row="1"
      MaxWidth="560"
      VerticalAlignment="Center"
      Style="{StaticResource SurfaceCard}"
      Visibility="{Binding HasGamma, Converter={StaticResource Boolean2VisibilityReConverter}}">
      <StackPanel Margin="12">
        <Path
          Width="36"
          Height="36"
          Data="{icons:Phosphor CompassBold}"
          Fill="{DynamicResource PrimaryBrush}"
          Stretch="Uniform" />
        <TextBlock
          Margin="0,12,0,0"
          HorizontalAlignment="Center"
          FontSize="{StaticResource FontSize.Lg}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource PrimaryTextBrush}"
          Text="Cadê o GAMMA?" />
        <TextBlock
          Margin="0,6,0,0"
          Style="{StaticResource CaptionText}"
          Text="O jeito mais fácil: coloque o Provodnik.exe dentro da pasta do GAMMA (ao lado do ModOrganizer.exe ou dentro de .Grok's Modpack Installer) e ele se acha sozinho. Ou escolha a pasta aqui."
          TextAlignment="Center"
          TextTrimming="None"
          TextWrapping="Wrap" />
        <Button
          Margin="0,16,0,0"
          HorizontalAlignment="Center"
          hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
          Command="{Binding ChooseFolderCommand}"
          Content="Escolher a pasta do GAMMA"
          Style="{StaticResource Action.Primary}" />
      </StackPanel>
    </Border>

    <!--  ===== Com GAMMA =====  -->
    <ScrollViewer
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      Visibility="{Binding HasGamma, Converter={StaticResource Boolean2VisibilityConverter}}">
      <StackPanel>
        <!--  O cartão principal: o estado à esquerda, Jogar e Instalar à direita  -->
        <Border Style="{StaticResource SurfaceCard}">
          <DockPanel>
            <StackPanel
              VerticalAlignment="Center"
              DockPanel.Dock="Right"
              Orientation="Horizontal">
              <hc:ComboBox
                Width="190"
                Margin="0,0,8,0"
                hc:InfoElement.Placeholder="Executável"
                ItemsSource="{Binding Executables}"
                SelectedItem="{Binding SelectedExecutable}"
                ToolTip="Qual executável do MO2 o Jogar abre (DX11-AVX é o recomendado)" />
              <Button
                Margin="0,0,8,0"
                hc:IconElement.Geometry="{icons:Phosphor DownloadSimpleBold}"
                Command="{Binding GoInstallCommand}"
                Content="Instalar / atualizar"
                IsEnabled="{Binding Install.IsRunning, Converter={StaticResource Boolean2BooleanReConverter}}"
                Style="{StaticResource Action}" />
              <Button
                Width="120"
                hc:IconElement.Geometry="{icons:Phosphor PlayFill}"
                Command="{Binding PlayCommand}"
                Content="Jogar"
                Style="{StaticResource Action.Primary}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse
                  Width="10"
                  Height="10"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Style="{StaticResource ToneDot}" />
                <TextBlock
                  FontSize="{StaticResource FontSize.Lg}"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  Text="{Binding StatusTitle}" />
                <hc:CircleProgressBar
                  Width="14"
                  Height="14"
                  Margin="10,0,0,0"
                  IsIndeterminate="True"
                  Style="{StaticResource BusyCircle}"
                  Visibility="{Binding IsChecking, Converter={StaticResource Boolean2VisibilityConverter}}" />
              </StackPanel>
              <TextBlock
                Margin="20,4,16,0"
                Style="{StaticResource CaptionText}"
                Text="{Binding StatusText}"
                TextTrimming="None"
                TextWrapping="Wrap" />
              <!--  A instalação rodando aparece aqui também, com a barra  -->
              <StackPanel Margin="20,10,16,0" Visibility="{Binding Install.IsRunning, Converter={StaticResource Boolean2VisibilityConverter}}">
                <TextBlock
                  Foreground="{DynamicResource PrimaryBrush}"
                  Text="{Binding Install.Headline}"
                  TextTrimming="CharacterEllipsis" />
                <ProgressBar
                  Height="6"
                  Margin="0,6,0,0"
                  Maximum="1"
                  Value="{Binding Install.Overall, Mode=OneWay}" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!--  Os números  -->
        <UniformGrid
          Margin="0,16,-10,0"
          Columns="5"
          Rows="1">
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="DEFINIÇÃO" />
              <TextBlock Style="{StaticResource StatNumber}" Text="{Binding VersionText}" />
              <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OnlineVersionText, StringFormat=no GitHub: {0}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="ADDONS NA PASTA" />
              <TextBlock Style="{StaticResource StatNumber}">
                <Run Text="{Binding ModsInstalled, Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ModsTotal, Mode=OneWay, StringFormat=' / {0}'}" />
              </TextBlock>
              <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ModListText, StringFormat=lista: {0}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="ATIVOS NO MO2" />
              <TextBlock Style="{StaticResource StatNumber}">
                <Run Text="{Binding ActiveFound, Mode=OneWay}" /><Run Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ActiveExpected, Mode=OneWay, StringFormat=' / {0}'}" />
              </TextBlock>
              <TextBlock Style="{StaticResource CaptionText}" Text="a regra dos 5xx" ToolTip="A regra dos 5xx mods: o número de mods ativos que o MO2 tem que mostrar muda a cada versão do GAMMA; aqui ele sai do modlist.txt do GAMMA" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="FALTANDO" />
              <TextBlock Style="{StaticResource StatNumber}" Text="{Binding ArchivesMissing}" />
              <TextBlock Style="{StaticResource CaptionText}" Text="arquivos pra baixar" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel>
              <TextBlock Style="{StaticResource StatLabel}" Text="ÚLTIMA INSTALAÇÃO" />
              <TextBlock
                Style="{StaticResource StatNumber}"
                FontFamily="{StaticResource FontFamily.Default}"
                FontSize="{StaticResource FontSize.Lg}"
                Text="{Binding LastInstallText}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource CaptionText}" Text="completa, sem falha" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!--  Onde está tudo: o cartão de informação da Связь (rótulo, valor à direita, abrir colado nele, divisória fina)  -->
        <TextBlock
          Margin="2,16,0,6"
          Style="{StaticResource StatLabel}"
          Text="PASTAS" />
        <Border Style="{StaticResource InfoCard}">
          <StackPanel>
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="GAMMA" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="Abrir" />
              <TextBlock
                FontFamily="{StaticResource FontFamily.Numbers}"
                Style="{StaticResource InfoValue}"
                Text="{Binding GammaRoot}" />
            </DockPanel>
            <Border Style="{StaticResource InfoDivider}" />
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="Anomaly" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                CommandParameter="anomaly"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="Abrir" />
              <TextBlock
                FontFamily="{StaticResource FontFamily.Numbers}"
                Style="{StaticResource InfoValue}"
                Text="{Binding AnomalyPath}" />
            </DockPanel>
            <Border Style="{StaticResource InfoDivider}" />
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="Perfil do MO2" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                CommandParameter="profile"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="Abrir" />
              <TextBlock Style="{StaticResource InfoValue}" Text="{Binding ProfileName}" />
            </DockPanel>
            <Border Style="{StaticResource InfoDivider}" />
            <DockPanel Style="{StaticResource InfoRow}">
              <TextBlock Style="{StaticResource InfoLabel}" Text="Mod Organizer" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor SlidersHorizontalBold}"
                Command="{Binding OpenModOrganizerCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="Abrir o Mod Organizer (sem o jogo)" />
              <Button
                Margin="8,0,0,0"
                hc:IconElement.Geometry="{icons:Phosphor FolderOpenBold}"
                Command="{Binding OpenFolderCommand}"
                CommandParameter="downloads"
                DockPanel.Dock="Right"
                Style="{StaticResource Action.Icon.Small}"
                ToolTip="Abrir downloads\" />
              <TextBlock Style="{StaticResource InfoValue}" Text="downloads\ e mods\ dentro da pasta do GAMMA" />
            </DockPanel>
          </StackPanel>
        </Border>
        <!--  Dica de usar dentro da pasta, só quando o exe está fora dela  -->
        <Border
          Margin="0,16,0,0"
          Style="{StaticResource SurfaceCard}"
          Visibility="{Binding IsPortable, Converter={StaticResource Boolean2VisibilityReConverter}}">
          <DockPanel>
            <Path
              Width="18"
              Height="18"
              Margin="0,0,12,0"
              VerticalAlignment="Top"
              Data="{icons:Phosphor LightbulbBold}"
              DockPanel.Dock="Left"
              Fill="{DynamicResource WarningBrush}"
              Stretch="Uniform" />
            <TextBlock
              Foreground="{DynamicResource SecondaryTextBrush}"
              TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Dica:" />
              <Run Text="copie o Provodnik.exe pra dentro da pasta do GAMMA (ao lado do ModOrganizer.exe). Assim ele acha tudo sozinho, anda junto se a pasta mudar de lugar e substitui o G.A.M.M.A. Launcher.exe sem configurar nada." />
            </TextBlock>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
