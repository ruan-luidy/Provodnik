<!--
  Modelos, regras e contratos do Проводник. ZERO pacotes de terceiros: só a BCL.
  Não sabe nada de curl, 7-Zip, git ou WPF.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Provodnik.Tests" />
  </ItemGroup>

  <!--  Os textos em português, inglês e russo (Provodnik.Core.Text.L lê os que terminam em .pt/.en/.ru.json)  -->
  <ItemGroup>
    <!-- WithCulture=false: senão o .pt/.en/.ru do nome vira assembly satélite e some do assembly principal -->
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" />
  </ItemGroup>

</Project>
